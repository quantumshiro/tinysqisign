 {
+    V3_STATIC_REQUIRE(isog_len > 0 && isog_len <= V3_STATIC_MAX_ISOG_LEN);
     ec_curve_normalize_A24(curve);
     ec_point_t A24;
     ec_copy_point(&A24, &curve->A24);
@@ -58,10 +62,11 @@ iso_isogeny_2chain_with_strategy(ec_curve_t *curve, const ec_point_t *kernel, co
     int space = 1;
     for (int i = 1; i < isog_len; i *= 2)
         ++space;
+    V3_STATIC_REQUIRE(space <= V3_STATIC_CHAIN_SPACE);
 
     // Stack of remaining kernel points and their associated orders
-    ec_point_t splits[space];
-    uint16_t todo[space];
+    ec_point_t splits[V3_STATIC_CHAIN_SPACE];
+    uint16_t todo[V3_STATIC_CHAIN_SPACE];
     splits[0] = *kernel;
     todo[0] = isog_len;
 
