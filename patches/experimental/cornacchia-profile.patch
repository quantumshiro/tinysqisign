 #include <stdlib.h>
 #include <string.h>
 
+#if defined(SQISIGN_CORNACCHIA_SCA_PROFILE)
+#include <inttypes.h>
+#include <stdio.h>
+
+static uint64_t cornacchia_profile_sequence;
+
+static unsigned
+profile_hamming_weight(const ibz_t *value)
+{
+    unsigned weight = 0;
+    for (size_t limb = 0; limb < IBZ_LIMBS; ++limb)
+        weight += (unsigned)__builtin_popcountll((*value)[limb]);
+    return weight;
+}
+
+static uint64_t
+profile_digest(const ibz_t *value)
+{
+    uint64_t digest = UINT64_C(1469598103934665603);
+    for (size_t limb = 0; limb < IBZ_LIMBS; ++limb) {
+        uint64_t word = (*value)[limb];
+        for (unsigned byte = 0; byte < 8; ++byte) {
+            digest ^= (uint8_t)(word >> (8 * byte));
+            digest *= UINT64_C(1099511628211);
+        }
+    }
+    return digest;
+}
+
+static void
+profile_cornacchia_sqrt(const ibz_t *modulus, int sqrt_status)
+{
+    ibz_t q, x_exponent;
+    ibz_sub(&q, modulus, &ibz_const_one);
+    unsigned two_adicity = 0;
+    while (ibz_is_even(&q)) {
+        ibz_div_2exp(&q, &q, 1);
+        ++two_adicity;
+    }
+    ibz_add(&x_exponent, &q, &ibz_const_one);
+    ibz_div_2exp(&x_exponent, &x_exponent, 1);
+
+    const unsigned long mod8 = ibz_mod_ui(modulus, 8);
+    fprintf(stderr,
+            "SQISIGN_CORNACCHIA_PROFILE sequence=%" PRIu64
+            " modulus_bits=%d modulus_mod8=%lu two_adicity=%u"
+            " q_bits=%d q_weight=%u x_bits=%d x_weight=%u"
+            " modulus_fnv64=%016" PRIx64 " sqrt_status=%d"
+            " published_fast_case=%d\n",
+            ++cornacchia_profile_sequence,
+            ibz_bitsize(modulus),
+            mod8,
+            two_adicity,
+            ibz_bitsize(&q),
+            profile_hamming_weight(&q),
+            ibz_bitsize(&x_exponent),
+            profile_hamming_weight(&x_exponent),
+            profile_digest(modulus),
+            sqrt_status,
+            mod8 == 5);
+}
+#endif
