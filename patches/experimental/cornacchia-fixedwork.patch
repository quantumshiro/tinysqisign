index 0000000000000000000000000000000000000000..4397f9890c1dda2412ffbd75f691e132180d4e9e
--- /dev/null
+++ b/src/quaternion/ref/generic/internal_quaternion_headers/powmod_fixedwork_521.h
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef SQISIGN_POWMOD_FIXEDWORK_521_H
+#define SQISIGN_POWMOD_FIXEDWORK_521_H
+
+#include <intbig.h>
+#include <stdint.h>
+
+enum {
+    SQISIGN_SCA_FIXEDWORK_BITS = 521,
+    SQISIGN_SCA_FIXEDWORK_WORDS = 17,
+    SQISIGN_SCA_FIXEDWORK_POW_MULTIPLICATIONS =
+        2 * SQISIGN_SCA_FIXEDWORK_BITS,
+    SQISIGN_SCA_FIXEDWORK_MUL_ITERATIONS =
+        SQISIGN_SCA_FIXEDWORK_BITS,
+    SQISIGN_SCA_FIXEDWORK_POW_MUL_ITERATIONS =
+        SQISIGN_SCA_FIXEDWORK_POW_MULTIPLICATIONS *
+        SQISIGN_SCA_FIXEDWORK_MUL_ITERATIONS,
+    SQISIGN_SCA_FIXEDWORK_POW_MODULAR_ADDITIONS =
+        2 * SQISIGN_SCA_FIXEDWORK_POW_MUL_ITERATIONS,
+};
+
+typedef uint32_t sqisign_sca_u521_t[SQISIGN_SCA_FIXEDWORK_WORDS];
+
+/* Caller-owned so the protected square-root route does not add this storage
+ * once per nested arithmetic call.  No field may overlap an input/output
+ * ibz_t.  Each public operation clears the complete object before return. */
+typedef struct {
+    sqisign_sca_u521_t modulus;
+    sqisign_sca_u521_t base;
+    sqisign_sca_u521_t result;
+    sqisign_sca_u521_t square;
+    sqisign_sca_u521_t multiplied;
+    sqisign_sca_u521_t multiply_accumulator;
+    sqisign_sca_u521_t multiply_addend;
+    sqisign_sca_u521_t selected_addend;
+    sqisign_sca_u521_t addition_sum;
+    sqisign_sca_u521_t subtraction_difference;
+    sqisign_sca_u521_t one;
+    sqisign_sca_u521_t exponent;
+    sqisign_sca_u521_t comparison;
+} sqisign_sca_fixedwork_workspace_t;
+
+/* Experimental fixed-work arithmetic for the bounded Level-I Cornacchia
+ * route.  The accepted domain is deliberately narrow: every operand must be
+ * nonnegative and fit in 521 bits, the modulus must be nonzero, and each base
+ * or multiplication operand must already be strictly below the modulus.
+ * Invalid input returns zero without publishing output.  There is no legacy
+ * arithmetic fallback.
+ *
+ * Every accepted multiplication executes 521 multiplier-bit rounds.  Every
+ * round executes two complete 17-word modular additions.  Exponentiation
+ * executes 521 exponent rounds and two multiplications per round.  This
+ * regular source/target schedule removes the published exponent-bit branch;
+ * it is not by itself a constant-power, constant-EM, or complete SQIsign
+ * side-channel-resistance claim. */
+int sqisign_sca_mul_mod_fixedwork_521_with_workspace(
+    ibz_t *product,
+    const ibz_t *a,
+    const ibz_t *b,
+    const ibz_t *modulus,
+    sqisign_sca_fixedwork_workspace_t *workspace);
+
+int sqisign_sca_powmod_fixedwork_521_with_workspace(
+    ibz_t *power,
+    const ibz_t *x,
+    const ibz_t *e,
+    const ibz_t *m,
+    sqisign_sca_fixedwork_workspace_t *workspace);
+
+int sqisign_sca_mul_mod_fixedwork_521(ibz_t *product,
+                                      const ibz_t *a,
+                                      const ibz_t *b,
+                                      const ibz_t *modulus);
+
+int sqisign_sca_powmod_fixedwork_521(ibz_t *power,
+                                     const ibz_t *x,
+                                     const ibz_t *e,
+                                     const ibz_t *m);
+
+#if defined(SQISIGN_SCA_FIXEDWORK_PROFILE)
+typedef struct {
+    uint64_t exponent_iterations;
+    uint64_t modular_multiplications;
+    uint64_t multiplier_iterations;
+    uint64_t modular_additions;
+} sqisign_sca_fixedwork_profile_t;
+
+void sqisign_sca_fixedwork_profile_reset(void);
+sqisign_sca_fixedwork_profile_t sqisign_sca_fixedwork_profile_read(void);
+#endif
+
+#endif
diff --git a/src/quaternion/ref/generic/internal_quaternion_headers/sqrt_mod_fixedwork_521.h b/src/quaternion/ref/generic/internal_quaternion_headers/sqrt_mod_fixedwork_521.h
