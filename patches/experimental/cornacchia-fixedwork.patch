index 0000000000000000000000000000000000000000..c03a013f12430b819d50f6799e8c39b39735b883
--- /dev/null
+++ b/src/quaternion/ref/generic/internal_quaternion_headers/sqrt_mod_fixedwork_521.h
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef SQISIGN_SQRT_MOD_FIXEDWORK_521_H
+#define SQISIGN_SQRT_MOD_FIXEDWORK_521_H
+
+#include "powmod_fixedwork_521.h"
+
+typedef enum {
+    SQISIGN_SCA_SQRT_FATAL = -1,
+    SQISIGN_SCA_SQRT_NO_ROOT = 0,
+    SQISIGN_SCA_SQRT_SUCCESS = 1,
+} sqisign_sca_sqrt_status_t;
+
+typedef struct {
+    sqisign_sca_fixedwork_workspace_t arithmetic;
+    ibz_t a_input;
+    ibz_t p_input;
+    ibz_t n;
+    ibz_t p_minus_one;
+    ibz_t q;
+    ibz_t z;
+    ibz_t c;
+    ibz_t q_plus_one;
+    ibz_t exponent;
+    ibz_t x;
+    ibz_t t;
+    ibz_t t_power;
+    ibz_t b;
+    ibz_t b_squared;
+    ibz_t legendre_exponent;
+    ibz_t legendre_power;
+} sqisign_sca_sqrt_fixedwork_workspace_t;
+
+/* Internal tri-state API for the Level-I Cornacchia experiment.
+ *
+ * SUCCESS and NO_ROOT match the legacy mathematical result.  FATAL means
+ * that a precondition or the frozen 521-bit bound was violated; callers must
+ * fail closed and must never retry through ibz_sqrt_mod_p.  The output may
+ * alias either input.  A domain rejection happens before output publication,
+ * and the complete workspace is cleared on every return. */
+sqisign_sca_sqrt_status_t sqisign_sca_sqrt_mod_p_fixedwork_521(
+    ibz_t *sqrt,
+    const ibz_t *a,
+    const ibz_t *p,
+    sqisign_sca_sqrt_fixedwork_workspace_t *workspace);
+
+#if defined(SQISIGN_CORNACCHIA_FIXEDWORK_PROFILE)
+typedef struct {
+    uint64_t sqrt_calls;
+    uint64_t legendre_calls;
+    uint64_t pow_calls;
+    uint64_t tonelli_shanks_mul_calls;
+    uint64_t successes;
+    uint64_t no_roots;
+    uint64_t fatals;
+} sqisign_sca_cornacchia_fixedwork_profile_t;
+
+void sqisign_sca_cornacchia_fixedwork_profile_reset(void);
+sqisign_sca_cornacchia_fixedwork_profile_t
+sqisign_sca_cornacchia_fixedwork_profile_read(void);
+#endif
+
+#endif
diff --git a/src/quaternion/ref/generic/powmod_fixedwork_521.c b/src/quaternion/ref/generic/powmod_fixedwork_521.c
new file mode 100644
index 0000000000000000000000000000000000000000..7e77099ad8c7ed27f41c9241ecb545e50d319631
--- /dev/null
+++ b/src/quaternion/ref/generic/powmod_fixedwork_521.c
@@ -0,0 +1,330 @@
+// SPDX-License-Identifier: Apache-2.0
+
+#include "powmod_fixedwork_521.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+#if defined(__GNUC__) && !defined(__clang__)
+#define SQISIGN_SCA_NOINLINE __attribute__((noinline, noclone))
+#elif defined(__GNUC__) || defined(__clang__)
+#define SQISIGN_SCA_NOINLINE __attribute__((noinline))
+#else
+#define SQISIGN_SCA_NOINLINE
+#endif
+
+_Static_assert(IBZ_LIMBS == 27,
+               "fixed-work Cornacchia experiment is Level-I only");
+_Static_assert(sizeof(ibz_t) == 216,
+               "fixed-work Cornacchia experiment requires the Level-I ibz ABI");
+_Static_assert(sizeof(sqisign_sca_u521_t) == 68,
+               "521-bit word representation changed");
+_Static_assert(sizeof(sqisign_sca_fixedwork_workspace_t) == 884,
+               "fixed-work workspace layout changed");
+
+#if defined(SQISIGN_SCA_FIXEDWORK_PROFILE)
+static sqisign_sca_fixedwork_profile_t profile;
+
+void
+sqisign_sca_fixedwork_profile_reset(void)
+{
+    profile.exponent_iterations = 0;
+    profile.modular_multiplications = 0;
+    profile.multiplier_iterations = 0;
+    profile.modular_additions = 0;
+}
+
+sqisign_sca_fixedwork_profile_t
+sqisign_sca_fixedwork_profile_read(void)
+{
+    return profile;
+}
+#endif
+
+static uint32_t
+nonzero_u32(uint32_t value)
+{
+    return (value | (UINT32_C(0) - value)) >> 31;
+}
+
+static uint32_t
+fits_nonnegative_521(const ibz_t *value)
+{
+    uint64_t outside = (*value)[8] & ~UINT64_C(0x1ff);
+    for (size_t limb = 9; limb < IBZ_LIMBS; ++limb)
+        outside |= (*value)[limb];
+    return (uint32_t)(((outside | (UINT64_C(0) - outside)) >> 63) ^ 1U);
+}
+
+static void
+load_u521(sqisign_sca_u521_t target, const ibz_t *source)
+{
+    for (size_t word = 0; word < SQISIGN_SCA_FIXEDWORK_WORDS; ++word) {
+        const uint64_t limb = (*source)[word / 2];
+        target[word] =
+            (uint32_t)(limb >> ((unsigned)(word & 1U) * 32U));
+    }
+}
+
+static void
+store_u521(ibz_t *target, const sqisign_sca_u521_t source)
+{
+    for (size_t limb = 0; limb < IBZ_LIMBS; ++limb)
+        (*target)[limb] = 0;
+    for (size_t limb = 0; limb < 8; ++limb) {
+        (*target)[limb] = (uint64_t)source[2 * limb] |
+                          ((uint64_t)source[2 * limb + 1] << 32);
+    }
+    (*target)[8] = source[16];
+}
+
+static uint32_t
+subtract_words(sqisign_sca_u521_t difference,
+               const sqisign_sca_u521_t a,
+               const sqisign_sca_u521_t b)
+{
+    uint32_t borrow = 0;
+    for (size_t word = 0; word < SQISIGN_SCA_FIXEDWORK_WORDS; ++word) {
+        const uint64_t wide =
+            (uint64_t)a[word] - (uint64_t)b[word] - borrow;
+        difference[word] = (uint32_t)wide;
+        borrow = (uint32_t)(wide >> 63);
+    }
+    return borrow;
+}
+
+/* Inputs are in [0,m).  Their sum is below 2*m, so one subtraction is
+ * sufficient.  For m < 2^521 the sum fits in the 17-word extent. */
+SQISIGN_SCA_NOINLINE static void
+add_mod(sqisign_sca_u521_t output,
+        const sqisign_sca_u521_t a,
+        const sqisign_sca_u521_t b,
+        const sqisign_sca_u521_t modulus,
+        sqisign_sca_fixedwork_workspace_t *workspace)
+{
+    uint32_t carry = 0;
+    for (size_t word = 0; word < SQISIGN_SCA_FIXEDWORK_WORDS; ++word) {
+        const uint64_t wide = (uint64_t)a[word] + b[word] + carry;
+        workspace->addition_sum[word] = (uint32_t)wide;
+        carry = (uint32_t)(wide >> 32);
+    }
+
+    const uint32_t borrow =
+        subtract_words(workspace->subtraction_difference,
+                       workspace->addition_sum,
+                       modulus);
+    const uint32_t use_difference = UINT32_C(0) - (borrow ^ 1U);
+    const uint32_t use_sum = ~use_difference;
+    for (size_t word = 0; word < SQISIGN_SCA_FIXEDWORK_WORDS; ++word) {
+        output[word] =
+            (workspace->subtraction_difference[word] & use_difference) |
+            (workspace->addition_sum[word] & use_sum);
+    }
+
+#if defined(SQISIGN_SCA_FIXEDWORK_PROFILE)
+    profile.modular_additions++;
+#endif
+}
+
+static void
+reduce_one(sqisign_sca_u521_t output,
+           const sqisign_sca_u521_t modulus,
+           sqisign_sca_fixedwork_workspace_t *workspace)
+{
+    for (size_t word = 0; word < SQISIGN_SCA_FIXEDWORK_WORDS; ++word)
+        workspace->one[word] = 0;
+    workspace->one[0] = 1;
+
+    const uint32_t borrow =
+        subtract_words(workspace->subtraction_difference,
+                       workspace->one,
+                       modulus);
+    const uint32_t use_difference = UINT32_C(0) - (borrow ^ 1U);
+    const uint32_t use_one = ~use_difference;
+    for (size_t word = 0; word < SQISIGN_SCA_FIXEDWORK_WORDS; ++word) {
+        output[word] =
+            (workspace->subtraction_difference[word] & use_difference) |
+            (workspace->one[word] & use_one);
+    }
+}
+
+SQISIGN_SCA_NOINLINE static void
+multiply_mod_words(sqisign_sca_u521_t output,
+                   const sqisign_sca_u521_t a,
+                   const sqisign_sca_u521_t b,
+                   const sqisign_sca_u521_t modulus,
+                   sqisign_sca_fixedwork_workspace_t *workspace)
+{
+    for (size_t word = 0; word < SQISIGN_SCA_FIXEDWORK_WORDS; ++word) {
+        workspace->multiply_accumulator[word] = 0;
+        workspace->multiply_addend[word] = a[word];
+    }
+
+    for (unsigned bit = 0; bit < SQISIGN_SCA_FIXEDWORK_BITS; ++bit) {
+        const uint32_t multiplier_bit =
+            (b[bit / 32U] >> (bit % 32U)) & 1U;
+        const uint32_t select_addend = UINT32_C(0) - multiplier_bit;
+        for (size_t word = 0; word < SQISIGN_SCA_FIXEDWORK_WORDS; ++word) {
+            workspace->selected_addend[word] =
+                workspace->multiply_addend[word] & select_addend;
+        }
+
+        add_mod(workspace->multiply_accumulator,
+                workspace->multiply_accumulator,
+                workspace->selected_addend,
+                modulus,
+                workspace);
+        add_mod(workspace->multiply_addend,
+                workspace->multiply_addend,
+                workspace->multiply_addend,
+                modulus,
+                workspace);
+#if defined(SQISIGN_SCA_FIXEDWORK_PROFILE)
+        profile.multiplier_iterations++;
+#endif
+    }
+
+    for (size_t word = 0; word < SQISIGN_SCA_FIXEDWORK_WORDS; ++word)
+        output[word] = workspace->multiply_accumulator[word];
+#if defined(SQISIGN_SCA_FIXEDWORK_PROFILE)
+    profile.modular_multiplications++;
+#endif
+}
+
+static uint32_t
+words_nonzero(const sqisign_sca_u521_t value)
+{
+    uint32_t combined = 0;
+    for (size_t word = 0; word < SQISIGN_SCA_FIXEDWORK_WORDS; ++word)
+        combined |= value[word];
+    return nonzero_u32(combined);
+}
+
+static void
+wipe_workspace(sqisign_sca_fixedwork_workspace_t *workspace)
+{
+    volatile uint32_t *words = (volatile uint32_t *)workspace;
+    for (size_t word = 0; word < sizeof(*workspace) / sizeof(*words); ++word)
+        words[word] = 0;
+}
+
+int
+sqisign_sca_mul_mod_fixedwork_521_with_workspace(
+    ibz_t *product,
+    const ibz_t *a,
+    const ibz_t *b,
+    const ibz_t *modulus,
+    sqisign_sca_fixedwork_workspace_t *workspace)
+{
+    load_u521(workspace->base, a);
+    load_u521(workspace->result, b);
+    load_u521(workspace->modulus, modulus);
+
+    const uint32_t a_below_modulus =
+        subtract_words(workspace->comparison,
+                       workspace->base,
+                       workspace->modulus);
+    const uint32_t b_below_modulus =
+        subtract_words(workspace->comparison,
+                       workspace->result,
+                       workspace->modulus);
+    const uint32_t valid = fits_nonnegative_521(a) &
+                           fits_nonnegative_521(b) &
+                           fits_nonnegative_521(modulus) &
+                           words_nonzero(workspace->modulus) &
+                           a_below_modulus & b_below_modulus;
+    if (valid == 0) {
+        wipe_workspace(workspace);
+        return 0;
+    }
+
+    multiply_mod_words(workspace->square,
+                       workspace->base,
+                       workspace->result,
+                       workspace->modulus,
+                       workspace);
+    store_u521(product, workspace->square);
+    wipe_workspace(workspace);
+    return 1;
+}
+
+int
+sqisign_sca_powmod_fixedwork_521_with_workspace(
+    ibz_t *power,
+    const ibz_t *x,
+    const ibz_t *e,
+    const ibz_t *m,
+    sqisign_sca_fixedwork_workspace_t *workspace)
+{
+    load_u521(workspace->base, x);
+    load_u521(workspace->modulus, m);
+    load_u521(workspace->exponent, e);
+
+    const uint32_t base_below_modulus =
+        subtract_words(workspace->comparison,
+                       workspace->base,
+                       workspace->modulus);
+    const uint32_t valid = fits_nonnegative_521(x) &
+                           fits_nonnegative_521(e) &
+                           fits_nonnegative_521(m) &
+                           words_nonzero(workspace->modulus) &
+                           base_below_modulus;
+    if (valid == 0) {
+        wipe_workspace(workspace);
+        return 0;
+    }
+
+    reduce_one(workspace->result, workspace->modulus, workspace);
+    for (int bit = SQISIGN_SCA_FIXEDWORK_BITS - 1; bit >= 0; --bit) {
+        multiply_mod_words(workspace->square,
+                           workspace->result,
+                           workspace->result,
+                           workspace->modulus,
+                           workspace);
+        multiply_mod_words(workspace->multiplied,
+                           workspace->square,
+                           workspace->base,
+                           workspace->modulus,
+                           workspace);
+
+        const uint32_t exponent_bit =
+            (workspace->exponent[(unsigned)bit / 32U] >>
+             ((unsigned)bit % 32U)) & 1U;
+        const uint32_t select_multiplied = UINT32_C(0) - exponent_bit;
+        const uint32_t select_square = ~select_multiplied;
+        for (size_t word = 0; word < SQISIGN_SCA_FIXEDWORK_WORDS; ++word) {
+            workspace->result[word] =
+                (workspace->square[word] & select_square) |
+                (workspace->multiplied[word] & select_multiplied);
+        }
+#if defined(SQISIGN_SCA_FIXEDWORK_PROFILE)
+        profile.exponent_iterations++;
+#endif
+    }
+
+    store_u521(power, workspace->result);
+    wipe_workspace(workspace);
+    return 1;
+}
+
+int
+sqisign_sca_mul_mod_fixedwork_521(ibz_t *product,
+                                  const ibz_t *a,
+                                  const ibz_t *b,
+                                  const ibz_t *modulus)
+{
+    sqisign_sca_fixedwork_workspace_t workspace;
+    return sqisign_sca_mul_mod_fixedwork_521_with_workspace(
+        product, a, b, modulus, &workspace);
+}
+
+int
+sqisign_sca_powmod_fixedwork_521(ibz_t *power,
+                                 const ibz_t *x,
+                                 const ibz_t *e,
+                                 const ibz_t *m)
+{
+    sqisign_sca_fixedwork_workspace_t workspace;
+    return sqisign_sca_powmod_fixedwork_521_with_workspace(
+        power, x, e, m, &workspace);
+}
diff --git a/src/quaternion/ref/generic/sqrt_mod_fixedwork_521.c b/src/quaternion/ref/generic/sqrt_mod_fixedwork_521.c
new file mode 100644
index 0000000000000000000000000000000000000000..f6bfc56c5a74582dd16c48d82b18cd6f84224505
--- /dev/null
+++ b/src/quaternion/ref/generic/sqrt_mod_fixedwork_521.c
@@ -0,0 +1,272 @@
+// SPDX-License-Identifier: Apache-2.0
+
+#include "sqrt_mod_fixedwork_521.h"
+
+#include <mem.h>
+
+_Static_assert(sizeof(sqisign_sca_sqrt_fixedwork_workspace_t) == 4344,
+               "protected square-root workspace layout changed");
+
+#if defined(SQISIGN_CORNACCHIA_FIXEDWORK_PROFILE)
+static sqisign_sca_cornacchia_fixedwork_profile_t profile;
+
+void
+sqisign_sca_cornacchia_fixedwork_profile_reset(void)
+{
+    profile.sqrt_calls = 0;
+    profile.legendre_calls = 0;
+    profile.pow_calls = 0;
+    profile.tonelli_shanks_mul_calls = 0;
+    profile.successes = 0;
+    profile.no_roots = 0;
+    profile.fatals = 0;
+}
+
+sqisign_sca_cornacchia_fixedwork_profile_t
+sqisign_sca_cornacchia_fixedwork_profile_read(void)
+{
+    return profile;
+}
+#endif
+
+static int
+fixed_pow(ibz_t *result,
+          const ibz_t *base,
+          const ibz_t *exponent,
+          const ibz_t *modulus,
+          sqisign_sca_sqrt_fixedwork_workspace_t *workspace)
+{
+    const int ok = sqisign_sca_powmod_fixedwork_521_with_workspace(
+        result, base, exponent, modulus, &workspace->arithmetic);
+#if defined(SQISIGN_CORNACCHIA_FIXEDWORK_PROFILE)
+    if (ok)
+        profile.pow_calls++;
+#endif
+    return ok;
+}
+
+static int
+fixed_mul(ibz_t *result,
+          const ibz_t *a,
+          const ibz_t *b,
+          const ibz_t *modulus,
+          sqisign_sca_sqrt_fixedwork_workspace_t *workspace)
+{
+    const int ok = sqisign_sca_mul_mod_fixedwork_521_with_workspace(
+        result, a, b, modulus, &workspace->arithmetic);
+#if defined(SQISIGN_CORNACCHIA_FIXEDWORK_PROFILE)
+    if (ok)
+        profile.tonelli_shanks_mul_calls++;
+#endif
+    return ok;
+}
+
+enum {
+    FIXED_LEGENDRE_FATAL = -2,
+    FIXED_LEGENDRE_NONRESIDUE = -1,
+    FIXED_LEGENDRE_ZERO = 0,
+    FIXED_LEGENDRE_RESIDUE = 1,
+};
+
+/* a must already be in [0,p). */
+static int
+fixed_legendre(const ibz_t *a,
+               const ibz_t *p,
+               sqisign_sca_sqrt_fixedwork_workspace_t *workspace)
+{
+#if defined(SQISIGN_CORNACCHIA_FIXEDWORK_PROFILE)
+    profile.legendre_calls++;
+#endif
+    if (ibz_is_zero(a))
+        return FIXED_LEGENDRE_ZERO;
+
+    ibz_div_2exp(&workspace->legendre_exponent,
+                 &workspace->p_minus_one,
+                 1);
+    if (!fixed_pow(&workspace->legendre_power,
+                   a,
+                   &workspace->legendre_exponent,
+                   p,
+                   workspace))
+        return FIXED_LEGENDRE_FATAL;
+
+    if (ibz_is_one(&workspace->legendre_power))
+        return FIXED_LEGENDRE_RESIDUE;
+    if (ibz_cmp(&workspace->legendre_power,
+                &workspace->p_minus_one) == 0)
+        return FIXED_LEGENDRE_NONRESIDUE;
+    return FIXED_LEGENDRE_FATAL;
+}
+
+sqisign_sca_sqrt_status_t
+sqisign_sca_sqrt_mod_p_fixedwork_521(
+    ibz_t *sqrt,
+    const ibz_t *a,
+    const ibz_t *p,
+    sqisign_sca_sqrt_fixedwork_workspace_t *workspace)
+{
+    sqisign_sca_sqrt_status_t status = SQISIGN_SCA_SQRT_FATAL;
+    int published_zero = 0;
+
+#if defined(SQISIGN_CORNACCHIA_FIXEDWORK_PROFILE)
+    profile.sqrt_calls++;
+#endif
+
+    /* Preserve both inputs before output publication; Cornacchia calls this
+     * with sqrt == a, and the internal contract also permits sqrt == p. */
+    ibz_copy(&workspace->a_input, a);
+    ibz_copy(&workspace->p_input, p);
+    const ibz_t *modulus = &workspace->p_input;
+
+    /* The special p==2 Cornacchia case is handled by its caller.  Checking
+     * the frozen width before touching sqrt makes domain rejection
+     * transactional and prevents a secret-dependent legacy fallback. */
+    if (ibz_cmp_int32(modulus, 2) <= 0 ||
+        ibz_is_even(modulus) ||
+        ibz_bitsize(modulus) > SQISIGN_SCA_FIXEDWORK_BITS)
+        goto cleanup;
+
+    ibz_init(sqrt);
+    published_zero = 1;
+
+    ibz_mod(&workspace->n, &workspace->a_input, modulus);
+    if (ibz_is_zero(&workspace->n)) {
+        status = SQISIGN_SCA_SQRT_SUCCESS;
+        goto cleanup;
+    }
+
+    ibz_sub(&workspace->p_minus_one,
+            modulus,
+            (const ibz_t *)&ibz_const_one);
+    const int n_symbol = fixed_legendre(&workspace->n, modulus, workspace);
+    if (n_symbol == FIXED_LEGENDRE_FATAL)
+        goto cleanup;
+    if (n_symbol != FIXED_LEGENDRE_RESIDUE) {
+        status = SQISIGN_SCA_SQRT_NO_ROOT;
+        goto cleanup;
+    }
+
+    /* Factor p-1=q*2^s.  This loop remains variable-work and is explicitly
+     * outside the exponent-schedule claim of this checkpoint. */
+    ibz_copy(&workspace->q, &workspace->p_minus_one);
+    int s = 0;
+    while (ibz_is_even(&workspace->q)) {
+        ibz_div_2exp(&workspace->q, &workspace->q, 1);
+        s++;
+    }
+    if (s <= 0)
+        goto cleanup;
+
+    /* Find a quadratic non-residue.  Candidate count remains variable; every
+     * candidate exponentiation itself follows the fixed 521-round route. */
+    ibz_set(&workspace->z, 2);
+    for (;;) {
+        if (ibz_cmp(&workspace->z, modulus) >= 0)
+            goto cleanup;
+        const int z_symbol = fixed_legendre(&workspace->z, modulus, workspace);
+        if (z_symbol == FIXED_LEGENDRE_FATAL ||
+            z_symbol == FIXED_LEGENDRE_ZERO)
+            goto cleanup;
+        if (z_symbol == FIXED_LEGENDRE_NONRESIDUE)
+            break;
+        ibz_add(&workspace->z,
+                &workspace->z,
+                (const ibz_t *)&ibz_const_one);
+    }
+
+    if (!fixed_pow(&workspace->c,
+                   &workspace->z,
+                   &workspace->q,
+                   modulus,
+                   workspace))
+        goto cleanup;
+
+    ibz_add(&workspace->q_plus_one,
+            &workspace->q,
+            (const ibz_t *)&ibz_const_one);
+    ibz_div_2exp(&workspace->exponent,
+                 &workspace->q_plus_one,
+                 1);
+    if (!fixed_pow(&workspace->x,
+                   &workspace->n,
+                   &workspace->exponent,
+                   modulus,
+                   workspace))
+        goto cleanup;
+
+    if (!fixed_pow(&workspace->t,
+                   &workspace->n,
+                   &workspace->q,
+                   modulus,
+                   workspace))
+        goto cleanup;
+
+    int m = s;
+    while (!ibz_is_one(&workspace->t)) {
+        int i;
+        ibz_copy(&workspace->t_power, &workspace->t);
+        for (i = 1; i < m; ++i) {
+            if (!fixed_mul(&workspace->t_power,
+                           &workspace->t_power,
+                           &workspace->t_power,
+                           modulus,
+                           workspace))
+                goto cleanup;
+            if (ibz_is_one(&workspace->t_power))
+                break;
+        }
+        if (i == m) {
+            status = SQISIGN_SCA_SQRT_NO_ROOT;
+            goto cleanup;
+        }
+
+        ibz_copy(&workspace->b, &workspace->c);
+        for (int j = 0; j < m - i - 1; ++j) {
+            if (!fixed_mul(&workspace->b,
+                           &workspace->b,
+                           &workspace->b,
+                           modulus,
+                           workspace))
+                goto cleanup;
+        }
+        if (!fixed_mul(&workspace->x,
+                       &workspace->x,
+                       &workspace->b,
+                       modulus,
+                       workspace))
+            goto cleanup;
+        if (!fixed_mul(&workspace->b_squared,
+                       &workspace->b,
+                       &workspace->b,
+                       modulus,
+                       workspace))
+            goto cleanup;
+        if (!fixed_mul(&workspace->t,
+                       &workspace->t,
+                       &workspace->b_squared,
+                       modulus,
+                       workspace))
+            goto cleanup;
+        ibz_copy(&workspace->c, &workspace->b_squared);
+        m = i;
+    }
+
+    ibz_copy(sqrt, &workspace->x);
+    status = SQISIGN_SCA_SQRT_SUCCESS;
+
+cleanup:
+#if defined(SQISIGN_CORNACCHIA_FIXEDWORK_PROFILE)
+    if (status == SQISIGN_SCA_SQRT_SUCCESS)
+        profile.successes++;
+    else if (status == SQISIGN_SCA_SQRT_NO_ROOT)
+        profile.no_roots++;
+    else
+        profile.fatals++;
+#endif
+    /* published_zero is intentionally retained as a local invariant: fatal
+     * domain rejection occurs before publication; later internal fatal paths
+     * leave zero and are fail-stop at the sole production adapter. */
+    (void)published_zero;
+    sqisign_secure_clear(workspace, sizeof(*workspace));
+    return status;
+}
