diff --git a/src/quaternion/ref/generic/test/test_cornacchia_fixedwork_521.c b/src/quaternion/ref/generic/test/test_cornacchia_fixedwork_521.c
new file mode 100644
index 0000000000000000000000000000000000000000..b5618e785d473f4161011d3ab9f92a695adb603e
--- /dev/null
+++ b/src/quaternion/ref/generic/test/test_cornacchia_fixedwork_521.c
@@ -0,0 +1,300 @@
+// SPDX-License-Identifier: Apache-2.0
+
+#include "sqrt_mod_fixedwork_521.h"
+
+#include <quaternion.h>
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+typedef struct {
+    uint64_t before[4];
+    sqisign_sca_sqrt_fixedwork_workspace_t workspace;
+    uint64_t after[4];
+} guarded_workspace_t;
+
+static int
+all_zero(const void *memory, size_t length)
+{
+    const unsigned char *bytes = memory;
+    unsigned char combined = 0;
+    for (size_t i = 0; i < length; ++i)
+        combined |= bytes[i];
+    return combined == 0;
+}
+
+static int
+guards_equal(const guarded_workspace_t *guarded, uint64_t value)
+{
+    for (size_t i = 0; i < 4; ++i) {
+        if (guarded->before[i] != value || guarded->after[i] != value)
+            return 0;
+    }
+    return 1;
+}
+
+static void
+prepare_guarded(guarded_workspace_t *guarded, uint64_t value)
+{
+    memset(guarded, 0xa5, sizeof(*guarded));
+    for (size_t i = 0; i < 4; ++i) {
+        guarded->before[i] = value;
+        guarded->after[i] = value;
+    }
+}
+
+static int
+profile_consistent(void)
+{
+#if defined(SQISIGN_CORNACCHIA_FIXEDWORK_PROFILE)
+    const sqisign_sca_cornacchia_fixedwork_profile_t cornacchia =
+        sqisign_sca_cornacchia_fixedwork_profile_read();
+    const sqisign_sca_fixedwork_profile_t arithmetic =
+        sqisign_sca_fixedwork_profile_read();
+    const uint64_t multiplications =
+        cornacchia.pow_calls *
+            SQISIGN_SCA_FIXEDWORK_POW_MULTIPLICATIONS +
+        cornacchia.tonelli_shanks_mul_calls;
+    return arithmetic.exponent_iterations ==
+               cornacchia.pow_calls * SQISIGN_SCA_FIXEDWORK_BITS &&
+           arithmetic.modular_multiplications == multiplications &&
+           arithmetic.multiplier_iterations ==
+               multiplications * SQISIGN_SCA_FIXEDWORK_MUL_ITERATIONS &&
+           arithmetic.modular_additions ==
+               2 * multiplications * SQISIGN_SCA_FIXEDWORK_MUL_ITERATIONS;
+#else
+    return 1;
+#endif
+}
+
+static void
+reset_profiles(void)
+{
+#if defined(SQISIGN_CORNACCHIA_FIXEDWORK_PROFILE)
+    sqisign_sca_fixedwork_profile_reset();
+    sqisign_sca_cornacchia_fixedwork_profile_reset();
+#endif
+}
+
+static int
+profile_one_success(void)
+{
+#if defined(SQISIGN_CORNACCHIA_FIXEDWORK_PROFILE)
+    const sqisign_sca_cornacchia_fixedwork_profile_t profile =
+        sqisign_sca_cornacchia_fixedwork_profile_read();
+    return profile.sqrt_calls == 1 && profile.successes == 1 &&
+           profile.no_roots == 0 && profile.fatals == 0 &&
+           profile.pow_calls >= 4 && profile_consistent();
+#else
+    return 1;
+#endif
+}
+
+static int
+profile_one_no_root(void)
+{
+#if defined(SQISIGN_CORNACCHIA_FIXEDWORK_PROFILE)
+    const sqisign_sca_cornacchia_fixedwork_profile_t profile =
+        sqisign_sca_cornacchia_fixedwork_profile_read();
+    return profile.sqrt_calls == 1 && profile.no_roots == 1 &&
+           profile.successes == 0 && profile.fatals == 0 &&
+           profile.pow_calls == 1 && profile_consistent();
+#else
+    return 1;
+#endif
+}
+
+static int
+profile_two_fatals(void)
+{
+#if defined(SQISIGN_CORNACCHIA_FIXEDWORK_PROFILE)
+    const sqisign_sca_cornacchia_fixedwork_profile_t profile =
+        sqisign_sca_cornacchia_fixedwork_profile_read();
+    return profile.sqrt_calls == 2 && profile.fatals == 2 &&
+           profile.successes == 0 && profile.no_roots == 0;
+#else
+    return 1;
+#endif
+}
+
+static int
+run_residue_case(int32_t prime, int32_t root)
+{
+    ibz_t p, a, legacy, protected, check;
+    ibz_set(&p, prime);
+    ibz_set(&a, root);
+    ibz_mul(&a, &a, &a);
+    ibz_mod(&a, &a, &p);
+
+    if (!ibz_sqrt_mod_p(&legacy, &a, &p))
+        return 0;
+
+    guarded_workspace_t guarded;
+    const uint64_t guard = UINT64_C(0x92d68ca2f1437b5e);
+    prepare_guarded(&guarded, guard);
+    reset_profiles();
+    const sqisign_sca_sqrt_status_t status =
+        sqisign_sca_sqrt_mod_p_fixedwork_521(
+            &protected, &a, &p, &guarded.workspace);
+    ibz_mul(&check, &protected, &protected);
+    ibz_mod(&check, &check, &p);
+    return status == SQISIGN_SCA_SQRT_SUCCESS &&
+           ibz_cmp(&protected, &legacy) == 0 &&
+           ibz_cmp(&check, &a) == 0 &&
+           guards_equal(&guarded, guard) &&
+           all_zero(&guarded.workspace, sizeof(guarded.workspace)) &&
+           profile_one_success();
+}
+
+static int
+test_residue_families(void)
+{
+    static const struct {
+        int32_t prime;
+        int32_t root;
+    } cases[] = {
+        { 3, 1 },
+        { 5, 2 },
+        { 13, 5 },
+        { 17, 7 },
+        { 41, 11 },
+        { 97, 19 },
+        { 193, 23 },
+        { 257, 31 },
+        { 769, 37 },
+        { 12289, 101 },
+    };
+    for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); ++i) {
+        if (!run_residue_case(cases[i].prime, cases[i].root)) {
+            fprintf(stderr,
+                    "fixed-work residue case failed p=%d root=%d\n",
+                    cases[i].prime,
+                    cases[i].root);
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static int
+test_aliases(void)
+{
+    guarded_workspace_t guarded;
+    ibz_t p, modulus, a, expected, check;
+    ibz_set(&p, 13);
+    ibz_set(&a, -1);
+    if (!ibz_sqrt_mod_p(&expected, &a, &p))
+        return 0;
+
+    prepare_guarded(&guarded, UINT64_C(0x0102030405060708));
+    if (sqisign_sca_sqrt_mod_p_fixedwork_521(
+            &a, &a, &p, &guarded.workspace) !=
+            SQISIGN_SCA_SQRT_SUCCESS ||
+        ibz_cmp(&a, &expected) != 0 ||
+        !all_zero(&guarded.workspace, sizeof(guarded.workspace)))
+        return 0;
+
+    ibz_set(&p, 13);
+    ibz_copy(&modulus, &p);
+    ibz_set(&a, 4);
+    prepare_guarded(&guarded, UINT64_C(0x1112131415161718));
+    if (sqisign_sca_sqrt_mod_p_fixedwork_521(
+            &p, &a, &p, &guarded.workspace) !=
+            SQISIGN_SCA_SQRT_SUCCESS)
+        return 0;
+    ibz_mul(&check, &p, &p);
+    ibz_mod(&check, &check, &modulus);
+    return ibz_cmp(&check, &a) == 0 &&
+           all_zero(&guarded.workspace, sizeof(guarded.workspace));
+}
+
+static int
+test_no_root(void)
+{
+    guarded_workspace_t guarded;
+    ibz_t p, a, legacy, protected;
+    ibz_set(&p, 13);
+    ibz_set(&a, 2);
+    ibz_set(&legacy, 9876);
+    ibz_set(&protected, 9876);
+    if (ibz_sqrt_mod_p(&legacy, &a, &p) != 0 ||
+        !ibz_is_zero(&legacy))
+        return 0;
+
+    prepare_guarded(&guarded, UINT64_C(0x2122232425262728));
+    reset_profiles();
+    const sqisign_sca_sqrt_status_t status =
+        sqisign_sca_sqrt_mod_p_fixedwork_521(
+            &protected, &a, &p, &guarded.workspace);
+    return status == SQISIGN_SCA_SQRT_NO_ROOT &&
+           ibz_is_zero(&protected) &&
+           guards_equal(&guarded, UINT64_C(0x2122232425262728)) &&
+           all_zero(&guarded.workspace, sizeof(guarded.workspace)) &&
+           profile_one_no_root();
+}
+
+static int
+test_domain_rejection(void)
+{
+    guarded_workspace_t guarded;
+    ibz_t p, a, output, sentinel;
+    ibz_set(&a, 4);
+    ibz_set(&sentinel, 6789);
+
+    ibz_set(&p, 1);
+    ibz_mul_2exp(&p, &p, 521);
+    ibz_add(&p, &p, (const ibz_t *)&ibz_const_one);
+    ibz_copy(&output, &sentinel);
+    prepare_guarded(&guarded, UINT64_C(0x3132333435363738));
+    reset_profiles();
+    if (sqisign_sca_sqrt_mod_p_fixedwork_521(
+            &output, &a, &p, &guarded.workspace) !=
+            SQISIGN_SCA_SQRT_FATAL ||
+        ibz_cmp(&output, &sentinel) != 0 ||
