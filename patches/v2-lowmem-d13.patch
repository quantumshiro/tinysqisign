+static int
+workspace_is_guarded_and_clear(void)
+{
+    const unsigned char *bytes =
+        (const unsigned char *)&guarded_workspace.workspace;
+    unsigned char residual = 0;
+    for (size_t i = 0; i < sizeof(guarded_workspace.before); i++) {
+        residual |= guarded_workspace.before[i] ^ 0x3c;
+        residual |= guarded_workspace.after[i] ^ 0xc3;
+    }
+    for (size_t i = 0; i < sizeof(guarded_workspace.workspace); i++) {
+        residual |= bytes[i];
+    }
+    return residual == 0;
