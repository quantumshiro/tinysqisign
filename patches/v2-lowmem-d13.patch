+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("build_dir", type=Path)
+    parser.add_argument(
+        "profile", choices=("production", "test", "test-lto", "arm-test")
+    )
+    parser.add_argument(
+        "--emit",
+        type=Path,
+        help="write observed manifests here instead of comparing (review use only)",
+    )
+    return parser.parse_args()
+
