+    for source, _, _, argv in selected:
+        flags = set(argv)
+        missing = required_flags - flags
+        if args.profile == "arm-test":
+            missing |= arm_flags - flags
+        if missing:
+            fail(f"{source}: missing frozen compile flags {sorted(missing)}")
