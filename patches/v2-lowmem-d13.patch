+    dpe_mul(out, out, value);
+    res |= !CHECK_CANONICAL_ZERO(out);
+    dpe_set(out, value);
+    dpe_mul(out, out, zero);
+    res |= !CHECK_CANONICAL_ZERO(out);
+    dpe_set(out, value);
+    dpe_mul(out, zero, out);
+    res |= !CHECK_CANONICAL_ZERO(out);
