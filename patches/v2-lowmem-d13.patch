+{
+    memset(guarded_dlog.before, 0x5a, sizeof(guarded_dlog.before));
+    memset(&guarded_dlog.workspace, 0xa5, sizeof(guarded_dlog.workspace));
+    memset(guarded_dlog.after, 0xa6, sizeof(guarded_dlog.after));
