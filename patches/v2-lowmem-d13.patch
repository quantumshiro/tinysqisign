+    res |= !CHECK_CANONICAL_ZERO(out);
+    dpe_div(out, zero, other);
+    res |= !CHECK_CANONICAL_ZERO(out);
+    dpe_set(out, zero);
+    dpe_div(out, out, value);
+    res |= !CHECK_CANONICAL_ZERO(out);
+    dpe_set(out, value);
+    dpe_div(out, zero, out);
+    res |= !CHECK_CANONICAL_ZERO(out);
+
+    dpe_mul(out, value, other);
+    res |= dpe_cmp_d(out, -0.375) != 0;
+    dpe_div(out, value, other);
+    res |= dpe_cmp_d(out, -1.5) != 0;
