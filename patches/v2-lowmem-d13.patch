+static void
+finduv_permutation_sift_down(uint16_t *permutation,
+                             size_t root,
+                             size_t count,
+                             finduv_sort_context_t *context)
+{
+    while (root < count / 2u) {
+        size_t child = 2u * root + 1u;
+        size_t largest = root;
+
+        if (finduv_compare_indices(context, permutation[largest], permutation[child]) < 0) {
+            largest = child;
+        }
+        if (child + 1u < count &&
+            finduv_compare_indices(
+                context, permutation[largest], permutation[child + 1u]) < 0) {
+            largest = child + 1u;
+        }
+        if (largest == root) {
+            return;
+        }
+
+        uint16_t swap = permutation[root];
+        permutation[root] = permutation[largest];
+        permutation[largest] = swap;
+        root = largest;
+    }
+}
+
+/* Produce permutation[new_position] = original_position in ascending
+ * (norm, original_position) order.  Heap sort needs no recursion or libc
+ * workspace and has a fixed O(count log count) comparison bound. */
+static int
+finduv_sort_permutation(uint16_t *permutation,
+                        size_t count,
+                        finduv_sort_context_t *context)
+{
+    if (permutation == NULL || context == NULL || count > FINDUV_cube_size ||
+        (count != 0 && (context->vecs == NULL || context->sketch == NULL ||
+                        context->gram == NULL ||
+                        context->adjusted_norm == NULL ||
+                        context->eval == NULL))) {
+        return 0;
+    }
+    for (size_t i = 0; i < count; i++) {
+        permutation[i] = (uint16_t)i;
+    }
+
+    for (size_t root = count / 2u; root > 0; root--) {
+        finduv_permutation_sift_down(permutation, root - 1u, count, context);
+    }
+    for (size_t end = count; end > 1u; end--) {
+        uint16_t swap = permutation[0];
+        permutation[0] = permutation[end - 1u];
+        permutation[end - 1u] = swap;
+        finduv_permutation_sift_down(permutation, 0, end - 1u, context);
+    }
+    return !context->fatal;
+}
