diff --git a/src/signature/ref/include/signature_lowmem.h b/src/signature/ref/include/signature_lowmem.h
new file mode 100644
index 0000000000000000000000000000000000000000..03bbf96fd97d039d62380e272ef38b46e6208d12
--- /dev/null
+++ b/src/signature/ref/include/signature_lowmem.h
@@ -0,0 +1,168 @@
+/** @file
+ *
+ * Explicit-workspace interfaces for low-memory SQIsign signing operations.
+ */
+
+#ifndef SIGNATURE_LOWMEM_H
+#define SIGNATURE_LOWMEM_H
+
+#include <id2iso.h>
+#include <signature.h>
+#include <verification_lowmem.h>
+
+/**
+ * Caller-owned mutable storage for the explicit low-memory KeyGen path.
+ *
+ * Key generation first uses the find_uv arena for random ideal sampling,
+ * equivalent-ideal search and IdealToIsogeny.  Once that phase has returned
+ * and cleared, its long-lived prefix is reused for bounded normalization,
+ * 2-power discrete-log and matrix-inversion scratch during Tate basis
+ * changes.  The object can contain
+ * secret-derived state, must reside in mutable SRAM, and must not overlap a
+ * key, parameter object or any other live object.  A valid non-NULL invocation
+ * does not request dynamic storage.  Link-level exclusion of unreachable
+ * legacy allocator compatibility code is a separate build and final-ELF
+ * property.
+ */
+typedef union protocols_keygen_workspace
+{
+    find_uv_workspace_t find_uv;
+    ec_dlog_2_workspace_t dlog;
+} protocols_keygen_workspace_t;
+
+/**
+ * Caller-owned mutable storage for the explicit low-memory Sign path.
+ *
+ * Commitment, response-ideal, auxiliary-isogeny, theta and basis-change
+ * phases are sequential.  Their largest bounded owner is the existing
+ * find_uv arena, so every smaller ML2/HNF/theta/dlog object overlays it at
+ * offset zero.  The object may contain secret-derived state and must be
+ * disjoint from all keys, messages, signatures and other live objects.
+ */
+typedef union protocols_sign_workspace
+{
+    find_uv_workspace_t find_uv;
+    quat_lattice_mul_workspace_t lattice_mul;
+    quat_ml2_retry_workspace_t ml2;
+    fixed_degree_isogeny_workspace_t fixed_degree;
+    theta_chain_workspace_t theta;
+    ec_dlog_2_workspace_t dlog;
+    ec_eval_even_workspace_t even_isogeny;
+} protocols_sign_workspace_t;
+
+/**
+ * One sequential-operation owner for encoded KeyGen, Sign and Verify.
+ *
+ * At most one member may be active.  Each public workspace entry clears its
+ * complete owned member before returning, so firmware can reuse this union
+ * for KeyGen, then Sign, then Verify without increasing the arena extent.
+ */
+typedef union protocols_operation_workspace
+{
+    protocols_keygen_workspace_t keygen;
+    protocols_sign_workspace_t sign;
+    protocols_verify_workspace_t verify;
+} protocols_operation_workspace_t;
+
+/** Clear a new or reusable caller-owned KeyGen workspace before first use. */
+void protocols_keygen_workspace_init(protocols_keygen_workspace_t *workspace);
+
+/** Securely clear every byte of a caller-owned KeyGen workspace. */
+void protocols_keygen_workspace_clear(protocols_keygen_workspace_t *workspace);
+
+/**
+ * Key generation using explicit caller-owned storage.
+ *
+ * The workspace must be non-NULL, disjoint from both output keys and all
+ * other live objects, and exclusively owned until return.  Every byte is
+ * securely cleared on every return path.  A NULL workspace is rejected before
+ * output or RNG state is touched.
+ */
+int protocols_keygen_with_workspace(public_key_t *pk,
+                                    secret_key_t *sk,
+                                    protocols_keygen_workspace_t *workspace);
+
+/** Clear a new or reusable caller-owned Sign workspace before first use. */
+void protocols_sign_workspace_init(protocols_sign_workspace_t *workspace);
+
+/** Securely clear every byte of a caller-owned Sign workspace. */
+void protocols_sign_workspace_clear(protocols_sign_workspace_t *workspace);
+
+/**
+ * Sign using explicit caller-owned storage and decoded keys.
+ *
+ * The workspace must be non-NULL, disjoint from all inputs and outputs, and
+ * exclusively owned until return.  Every byte is securely cleared on every
+ * return path.  A NULL workspace is rejected before output or RNG is touched.
+ */
+int protocols_sign_with_workspace(signature_t *sig,
+                                  const public_key_t *pk,
+                                  secret_key_t *sk,
+                                  const unsigned char *m,
+                                  size_t l,
+                                  protocols_sign_workspace_t *workspace);
+
+/**
+ * Decode an encoded secret key using explicit ML2/retry storage.
+ *
+ * The workspace must be non-NULL and disjoint from the encoded input and both
+ * decoded outputs. A NULL workspace is rejected before either output is
+ * modified. The nested ideal constructor clears its active storage on every
+ * return.
+ */
+int secret_key_from_bytes_with_workspace(
+    secret_key_t *sk,
+    public_key_t *pk,
+    const unsigned char *enc,
+    quat_ml2_retry_workspace_t *workspace);
+
+/**
+ * Generate an encoded SQIsign keypair using explicit caller-owned storage.
+ *
+ * Return values and encoded output lengths match sqisign_keypair: zero is
+ * success and nonzero is failure.  The workspace ownership and clearing
+ * contract is identical to protocols_keygen_with_workspace.
+ */
+SQISIGN_API
+int sqisign_keypair_with_workspace(
+    unsigned char *pk,
+    unsigned char *sk,
+    protocols_keygen_workspace_t *workspace);
+
+/**
+ * Generate an encoded SQIsign signed message using explicit caller storage.
+ *
+ * The workspace must be non-NULL and disjoint from every input/output. A NULL
+ * workspace is rejected before output, length or RNG state is touched. Return
+ * values and successful output bytes match sqisign_sign.
+ */
+SQISIGN_API
+int sqisign_sign_with_workspace(
+    unsigned char *sm,
+    unsigned long long *smlen,
+    const unsigned char *m,
+    unsigned long long mlen,
+    const unsigned char *sk,
+    protocols_sign_workspace_t *workspace);
+
+/** Verify an encoded detached signature using caller-owned bounded storage. */
+SQISIGN_API
+int sqisign_verify_with_workspace(
+    const unsigned char *m,
+    unsigned long long mlen,
+    const unsigned char *sig,
+    unsigned long long siglen,
+    const unsigned char *pk,
+    protocols_verify_workspace_t *workspace);
+
+/** Verify and open an encoded signed message using caller-owned storage. */
+SQISIGN_API
+int sqisign_open_with_workspace(
+    unsigned char *m,
+    unsigned long long *mlen,
+    const unsigned char *sm,
+    unsigned long long smlen,
+    const unsigned char *pk,
+    protocols_verify_workspace_t *workspace);
+
+#endif
