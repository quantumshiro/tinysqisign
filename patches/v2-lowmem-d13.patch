+    unsigned char residual = 0;
+    for (size_t i = 0; i < sizeof(guarded_dlog.before); i++) {
+        residual |= guarded_dlog.before[i] ^ 0x5a;
+        residual |= guarded_dlog.after[i] ^ 0xa6;
+    }
+    for (size_t i = 0; i < sizeof(guarded_dlog.workspace); i++)
+        residual |= workspace[i];
+    return residual == 0;
+}
+
+static void
+mp_workspace_fill(void)
+{
+    memset(guarded_mp.before, 0x3c, sizeof(guarded_mp.before));
+    memset(&guarded_mp.workspace, 0xa5, sizeof(guarded_mp.workspace));
+    memset(guarded_mp.after, 0xc3, sizeof(guarded_mp.after));
