+static int
+mp_workspace_contract_failures(void)
+{
+    digit_t r1[NWORDS_ORDER] = { 1 };
+    digit_t r2[NWORDS_ORDER] = { 1 };
+    digit_t s1[NWORDS_ORDER] = { 1 };
+    digit_t s2[NWORDS_ORDER] = { 2 };
+    digit_t before_r1[NWORDS_ORDER], before_r2[NWORDS_ORDER];
+    digit_t before_s1[NWORDS_ORDER], before_s2[NWORDS_ORDER];
+    int failed = 0;
+
+    mp_workspace_fill();
+    failed |= (mp_invert_matrix_with_workspace(r1,
+                                               r2,
+                                               s1,
+                                               s2,
+                                               TORSION_EVEN_POWER,
+                                               NWORDS_ORDER,
+                                               &guarded_mp.workspace) != 1)
+              << 0;
+    failed |= !(r1[0] == 2 && r2[0] == ~(digit_t)0 &&
+                s1[0] == ~(digit_t)0 && s2[0] == 1)
+              << 1;
+    for (size_t i = 1; i < NWORDS_ORDER; i++)
+        failed |= (r1[i] != 0 || r2[i] != ~(digit_t)0 ||
+                   s1[i] != ~(digit_t)0 || s2[i] != 0)
+                  << 2;
+    failed |= (!mp_workspace_is_guarded(0x00)) << 3;
+
+    memset(r1, 0, sizeof(r1));
+    memset(r2, 0, sizeof(r2));
+    memset(s1, 0, sizeof(s1));
+    memset(s2, 0, sizeof(s2));
+    r1[0] = 2;
+    s2[0] = 2;
+    memcpy(before_r1, r1, sizeof(r1));
+    memcpy(before_r2, r2, sizeof(r2));
+    memcpy(before_s1, s1, sizeof(s1));
+    memcpy(before_s2, s2, sizeof(s2));
+    mp_workspace_fill();
+    failed |= (mp_invert_matrix_with_workspace(r1,
+                                               r2,
+                                               s1,
+                                               s2,
+                                               TORSION_EVEN_POWER,
+                                               NWORDS_ORDER,
+                                               &guarded_mp.workspace) != 0)
+              << 4;
+    failed |= (!bytes_are_equal(r1, before_r1, sizeof(r1))) << 5;
+    failed |= (!bytes_are_equal(r2, before_r2, sizeof(r2))) << 6;
+    failed |= (!bytes_are_equal(s1, before_s1, sizeof(s1))) << 7;
+    failed |= (!bytes_are_equal(s2, before_s2, sizeof(s2))) << 8;
+    failed |= (!mp_workspace_is_guarded(0x00)) << 9;
+
+    mp_workspace_fill();
+    failed |= (mp_invert_matrix_with_workspace(
+                   r1, r2, s1, s2, TORSION_EVEN_POWER, NWORDS_ORDER, NULL) != 0)
+              << 10;
+    failed |= (!bytes_are_equal(r1, before_r1, sizeof(r1))) << 11;
+    failed |= (!bytes_are_equal(r2, before_r2, sizeof(r2))) << 12;
+    failed |= (!bytes_are_equal(s1, before_s1, sizeof(s1))) << 13;
+    failed |= (!bytes_are_equal(s2, before_s2, sizeof(s2))) << 14;
+    failed |= (!mp_workspace_is_guarded(0xa5)) << 15;
+    return failed;
+}
