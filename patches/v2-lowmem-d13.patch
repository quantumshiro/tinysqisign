+                          0,
+                          &context->vecs[first],
+                          context->gram,
+                          context->adjusted_norm) ||
+        !finduv_eval_norm(context->eval,
+                          1,
+                          &context->vecs[second],
+                          context->gram,
+                          context->adjusted_norm)) {
