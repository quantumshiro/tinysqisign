+        sqisign_secure_clear(workspace, sizeof(*workspace));
+    }
+}
+
+int
+protocols_keygen_with_workspace(public_key_t *pk,
+                                secret_key_t *sk,
+                                protocols_keygen_workspace_t *workspace)
+{
+    if (workspace == NULL) {
+        return 0;
+    }
+
+    protocols_keygen_workspace_init(workspace);
+
+    int found = 0;
+    ec_basis_t B_0_two;
+
+    while (!found) {
+        quat_random_ideal_status_t sampling_status =
+            quat_sampling_random_ideal_O0_given_norm_with_workspace(
+                &sk->secret_ideal,
+                &SEC_DEGREE,
+                1,
+                &QUAT_represent_integer_params,
+                NULL,
+                &workspace->find_uv.phase.lattice_mul.ml2);
+        if (sampling_status == QUAT_RANDOM_IDEAL_FATAL) {
+            goto cleanup;
+        }
+        found = sampling_status == QUAT_RANDOM_IDEAL_SUCCESS;
+
+        if (found) {
+            found = quat_lideal_prime_norm_reduced_equivalent_with_workspace(
+                &sk->secret_ideal,
+                &QUATALG_PINFTY,
+                QUAT_primality_num_iter,
+                QUAT_equiv_bound_coeff,
+                &workspace->find_uv.phase.lattice_mul.ml2);
+        }
+
+        if (found) {
+            int isogeny_status =
+                dim2id2iso_arbitrary_isogeny_evaluation_with_workspace(
+                    &B_0_two,
+                    &sk->curve,
+                    &sk->secret_ideal,
+                    &workspace->find_uv);
+            if (isogeny_status == ID2ISO_STATUS_FATAL) {
+                found = 0;
+                goto cleanup;
+            }
+            found = isogeny_status > 0;
+        }
+    }
+
+    assert(test_basis_order_twof(&B_0_two, &sk->curve, TORSION_EVEN_POWER));
+
+    if (!ec_curve_to_basis_2f_to_hint(
+            &sk->canonical_basis,
+            &sk->curve,
+            TORSION_EVEN_POWER,
+            &pk->hint_pk)) {
+        found = 0;
+        goto cleanup;
+    }
+
+    assert(test_basis_order_twof(
+        &sk->canonical_basis, &sk->curve, TORSION_EVEN_POWER));
+
+    if (!change_of_basis_matrix_tate_with_workspace(
+            &sk->mat_BAcan_to_BA0_two,
+            &sk->canonical_basis,
+            &B_0_two,
+            &sk->curve,
+            TORSION_EVEN_POWER,
+            &workspace->dlog)) {
+        found = 0;
+        goto cleanup;
+    }
+
+    copy_curve(&pk->curve, &sk->curve);
+    pk->curve.is_A24_computed_and_normalized = false;
+
+    assert(fp2_is_one(&pk->curve.C) == 0xFFFFFFFF);
+
+cleanup:
+    protocols_keygen_workspace_clear(workspace);
+    return found;
+}
