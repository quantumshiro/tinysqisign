+def writable_arm_sections(objdump_tool: str, object_name: str, object_path: Path) -> list[str]:
+    lines = run([objdump_tool, "-h", str(object_path)]).splitlines()
+    rows: list[str] = []
+    for index, line in enumerate(lines[:-1]):
+        match = re.match(
+            r"\s*\d+\s+(\S+)\s+([0-9a-fA-F]+)\s+[0-9a-fA-F]+\s+"
+            r"[0-9a-fA-F]+\s+[0-9a-fA-F]+\s+2\*\*\d+\s*$",
+            line,
+        )
+        if match is None:
+            continue
+        section, size_hex = match.groups()
+        size = int(size_hex, 16)
+        flags = {value.strip() for value in lines[index + 1].split(",")}
+        if size and "ALLOC" in flags and "READONLY" not in flags and "CODE" not in flags:
+            rows.append(
+                f"{object_name}\t{section}\t{size}\t{','.join(sorted(flags))}"
+            )
+    return rows
+
