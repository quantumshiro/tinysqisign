+    if (sketch == NULL || index >= FINDUV_cube_size || eval == NULL ||
+        ibz_cmp(&eval->norm[0], &ibz_const_zero) <= 0) {
+        return 0;
+    }
+    bits = ibz_bitsize(&eval->norm[0]);
+    if (bits <= 0 || bits > UINT16_MAX) {
+        return 0;
+    }
