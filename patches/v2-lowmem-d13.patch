new file mode 100644
index 0000000000000000000000000000000000000000..bc7f1a1f187bcb1a93b66788f7d5c2d572e51188
--- /dev/null
+++ b/src/quaternion/ref/generic/include/ml2_workspace.h
@@ -0,0 +1,87 @@
+/** @file
+ *
+ * @brief Caller-owned storage for fixed-capacity ML2 and its retry schedule.
+ */
+
+#ifndef QUAT_ML2_WORKSPACE_H
+#define QUAT_ML2_WORKSPACE_H
+
+#include "../internal_quaternion_headers/dpe.h"
+
+/** Maximum generator count accepted by the compact ML2 implementation. */
+#define QUAT_ML2_MAX_D 16
+
+/** Maximum generator count accepted by the fixed-capacity HNF workspace. */
+#define QUAT_HNF_MAX_GENERATORS 16
+
+/**
+ * Exact state of one ML2 reduction attempt.
+ *
+ * Every integer object in the active prefix is initialized and finalized by
+ * the ML2 entry point.  Callers must not inspect or retain pointers into this
+ * object.  It must not alias an input, output, algebra, or another live object,
+ * and one owner must have exclusive use until the call returns.  The type is
+ * exposed only so a higher-level phase workspace can own it without an
+ * automatic array or untyped storage.
+ */
+typedef struct quat_ml2_core_workspace
+{
+    int d;
+    int zeta;
+    int aborted;
+    const ibz_t *p;
+    ibz_t b[QUAT_ML2_MAX_D][4];
+    ibz_t G[QUAT_ML2_MAX_D][QUAT_ML2_MAX_D];
+    dpe_t r[QUAT_ML2_MAX_D][QUAT_ML2_MAX_D];
+    dpe_t mu[QUAT_ML2_MAX_D][QUAT_ML2_MAX_D];
+    dpe_t s[QUAT_ML2_MAX_D + 1];
+    dpe_t delta_bar;
+    dpe_t eta_bar;
+} quat_ml2_core_workspace_t;
+
+/**
+ * Complete simultaneously-live storage for deterministic ML2 retry.
+ *
+ * `permuted` remains live while `core` reduces a retry input, and `scratch`
+ * holds unpublished output until a rank-four attempt succeeds.  These members
+ * therefore must not overlap one another.  The complete object must not alias
+ * an input, output, algebra, or any other live object, and one owner must have
+ * exclusive use until the retry entry point returns.  The enclosing find_uv
+ * schedule may overlay this complete object with its later candidate phase
+ * only after all members have been finalized and securely cleared.  The retry
+ * entry point securely clears the complete object on every return path.
+ */
+typedef struct quat_ml2_retry_workspace
+{
+    quat_ml2_core_workspace_t core;
+    ibz_t permuted[QUAT_ML2_MAX_D][4];
+    ibz_t scratch[4][4];
+} quat_ml2_retry_workspace_t;
+
+/**
+ * Scratch rows for one 4-by-n HNF computation.
+ *
+ * The active prefix is initialized and finalized by the HNF workspace entry.
+ * The complete object is securely cleared on every return.  It must not alias
+ * the output matrix, generator input, modulus, or any other live object.
+ */
+typedef struct quat_hnf_workspace
+{
+    ibz_t rows[QUAT_HNF_MAX_GENERATORS][4];
+} quat_hnf_workspace_t;
+
+/**
+ * Mutually exclusive storage for the two lattice-product reduction routes.
+ *
+ * `quat_lattice_mul` selects either HNF or ML2 from input-dependent bounds;
+ * this is a variable-time route and those bounds are not generally public.
+ * The two algorithms are never simultaneously active.  A higher-level owner
+ * may therefore reserve their maximum rather than their sum.
+ */
+typedef union quat_lattice_mul_workspace
+{
+    quat_ml2_retry_workspace_t ml2;
+    quat_hnf_workspace_t hnf;
+} quat_lattice_mul_workspace_t;
+
+#endif
