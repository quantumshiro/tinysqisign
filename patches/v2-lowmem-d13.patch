+    if (bits > 64) {
+        ibz_div_2exp(&eval->norm[1], &eval->norm[0], (uint32_t)(bits - 64));
+        sketch->leading[index] = eval->norm[1][0];
+    } else {
+        sketch->leading[index] = eval->norm[0][0];
+    }
+    return 1;
+}
