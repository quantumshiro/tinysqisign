@@ -0,0 +1,243 @@
+#!/bin/sh
+set -eu
+export LC_ALL=C
+
+project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
+repro_label=${SQISIGN_LOWMEM_REPRO_LABEL:-D12c}
+if [ -n "$(git -C "$project_root" status --porcelain --untracked-files=normal)" ]; then
+    echo "$repro_label release reproduction requires a clean committed source tree" >&2
+    exit 1
+fi
+project_commit=$(git -C "$project_root" rev-parse HEAD)
+project_tree=$(git -C "$project_root" rev-parse 'HEAD^{tree}')
+arm_bin=${ARM_TOOLCHAIN_BIN:-}
+if [ -z "$arm_bin" ]; then
+    arm_gcc=$(command -v arm-none-eabi-gcc || true)
+    if [ -z "$arm_gcc" ]; then
+        echo "set ARM_TOOLCHAIN_BIN to the Arm GNU 15.2.1 bin directory" >&2
+        exit 2
+    fi
+    arm_bin=$(dirname -- "$arm_gcc")
+fi
+arm_gcc=$arm_bin/arm-none-eabi-gcc
+test -x "$arm_gcc"
+
+echo "$repro_label project commit: $project_commit"
+echo "$repro_label project tree:   $project_tree"
+uname -srvmp
+/usr/bin/cc --version
+python3 --version
+cmake --version
+ninja --version
+"$arm_gcc" --version
+
+scratch=$(mktemp -d "${TMPDIR:-/tmp}/sqisign-d12c-reproduce.XXXXXX")
+cleanup()
+{
+    if [ "${SQISIGN_KEEP_REPRO:-0}" = 1 ]; then
+        echo "kept $repro_label reproduction directory: $scratch"
+        return
+    fi
+    case "$scratch" in
+        "${TMPDIR:-/tmp}"/sqisign-d12c-reproduce.*) rm -rf -- "$scratch" ;;
+        *) echo "refusing to remove unexpected path: $scratch" >&2 ;;
+    esac
+}
+trap cleanup EXIT HUP INT TERM
+
+configure_host()
+{
+    build_dir=$1
+    tests=$2
+    no_ipo=$3
+    shift 3
+    cmake -S "$project_root" -B "$build_dir" -G Ninja \
+        -DCMAKE_C_COMPILER=/usr/bin/cc \
+        -DCMAKE_BUILD_TYPE=Release \
+        -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
+        -DSQISIGN_LOWMEM_ONLY=ON \
+        -DSQISIGN_LOWMEM_DIAGNOSTIC_NO_IPO="$no_ipo" \
+        -DGF_RADIX=32 \
+        -DENABLE_GMP=OFF \
+        -DENABLE_SIGN=ON \
+        -DENABLE_TESTS="$tests" \
+        "$@"
+}
+
+configure_normal_host()
+{
+    build_dir=$1
+    shift
+    cmake -S "$project_root" -B "$build_dir" -G Ninja \
+        -DCMAKE_C_COMPILER=/usr/bin/cc \
+        -DCMAKE_BUILD_TYPE=Release \
+        -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
+        -DGF_RADIX=32 \
+        -DENABLE_GMP=OFF \
+        -DENABLE_SIGN=ON \
+        -DENABLE_TESTS=ON \
+        "$@"
+}
+
+check_special_profile()
+{
+    commands=$1
+    profile=$2
+    expected_objects=$3
+    python3 - "$commands" "$profile" "$expected_objects" <<'PY'
+import json
+import os
+import re
+import shlex
+import sys
+
+commands = json.load(open(sys.argv[1], encoding="utf-8"))
+profile = sys.argv[2]
+expected_objects = int(sys.argv[3])
+checked = 0
+for entry in commands:
+    argv = entry.get("arguments") or shlex.split(entry["command"])
+    output = argv[argv.index("-o") + 1]
+    if not os.path.isabs(output):
+        output = os.path.join(entry["directory"], output)
+    if not os.path.isfile(output):
+        continue
+    checked += 1
+    if profile == "strict-alias":
+        alias = [x for x in argv if x in ("-fstrict-aliasing", "-fno-strict-aliasing")]
+        if not alias or alias[-1] != "-fstrict-aliasing":
+            raise SystemExit(f"{entry['file']}: strict aliasing is not effective: {alias}")
+    elif profile == "sanitizer":
+        opt = [x for x in argv if re.fullmatch(r"-O(?:[0-3sgz]|fast)?", x)]
+        if not opt or opt[-1] != "-O1":
+            raise SystemExit(f"{entry['file']}: sanitizer optimization is not O1: {opt}")
+        required = {
+            "-fsanitize=address,undefined",
+            "-fno-sanitize-recover=undefined",
+            "-fno-omit-frame-pointer",
+            "-fno-optimize-sibling-calls",
+        }
+        missing = required - set(argv)
+        if missing:
+            raise SystemExit(f"{entry['file']}: missing sanitizer flags {sorted(missing)}")
+    else:
+        raise SystemExit(f"unknown special profile: {profile}")
+if checked != expected_objects:
+    raise SystemExit(
+        f"{profile}: expected {expected_objects} selected objects, observed {checked}"
+    )
+print(f"{profile} effective-flag audit PASS ({checked} objects)")
+PY
+}
+
+host_production=$scratch/host-production
+configure_host "$host_production" OFF ON
+cmake --build "$host_production" --target sqisign_lvl1 -j4
+"$project_root/scripts/audit_lowmem_keygen_closure.sh" \
+    "$host_production" production
+
+host_test=$scratch/host-test
+configure_host "$host_test" ON ON
+cmake --build "$host_test" \
+    --target sqisign_test_keygen_workspace_closure_lvl1 -j4
+"$project_root/scripts/audit_lowmem_keygen_closure.sh" "$host_test" test
+
+# Preserve both normal-build compatibility VLAs and directly exercise the
+# HNF fixture, the Tate/Weil legacy/workspace dlog differential, and the
+# 12-seed legacy/workspace encoded KeyGen differential.
+host_compat=$scratch/host-normal-compat
+configure_normal_host "$host_compat"
+cmake --build "$host_compat" --target \
+    biextension.test_lvl1 \
+    sqisign_test_quaternion_lvl1 \
+    sqisign_test_keygen_workspace_lvl1 \
+    sqisign_test_sign_workspace_lvl1 -j4
+"$host_compat/src/ec/ref/lvl1/test/biextension.test_lvl1" --seed=1
+"$host_compat/src/quaternion/ref/generic/test/sqisign_test_quaternion_lvl1" \
+    --seed=1 --ml2-correctness-only
+"$host_compat/src/signature/ref/lvl1/test/sqisign_test_keygen_workspace_lvl1"
+"$host_compat/src/signature/ref/lvl1/test/sqisign_test_sign_workspace_lvl1"
+
+# ThinLTO is a secondary linked-symbol check.  Archive/member/relocation and
+# stack evidence above and below deliberately comes from non-LTO objects.
+host_lto=$scratch/host-test-lto
+configure_host "$host_lto" ON OFF
+cmake --build "$host_lto" \
+    --target sqisign_test_keygen_workspace_closure_lvl1 -j4
+"$project_root/scripts/audit_lowmem_keygen_closure.sh" "$host_lto" test-lto
+
+# This build really enables strict aliasing.  The project's ENABLE_STRICT path
+# appends -fno-strict-aliasing, so it cannot be used as aliasing evidence.
+host_alias=$scratch/host-effective-strict-alias
+configure_host "$host_alias" ON ON \
+    -DENABLE_STRICT=OFF \
+    "-DCMAKE_C_FLAGS=-O3 -fstrict-aliasing -Wstrict-aliasing=2 -Werror=strict-aliasing"
+cmake --build "$host_alias" \
+    --target sqisign_test_keygen_workspace_closure_lvl1 -j4
+check_special_profile "$host_alias/compile_commands.json" strict-alias 53
+"$host_alias/src/signature/ref/lvl1/test/sqisign_test_keygen_workspace_closure_lvl1"
+
+host_sanitizer=$scratch/host-asan-ubsan
+configure_host "$host_sanitizer" ON ON \
+    -DENABLE_STRICT=OFF \
+    "-DCMAKE_C_FLAGS=-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -fno-optimize-sibling-calls" \
+    "-DCMAKE_C_FLAGS_RELEASE=-O1 -g -DNDEBUG" \
+    "-DCMAKE_EXE_LINKER_FLAGS=-fsanitize=address,undefined"
+cmake --build "$host_sanitizer" \
+    --target sqisign_test_keygen_workspace_closure_lvl1 -j4
+check_special_profile "$host_sanitizer/compile_commands.json" sanitizer 53
+ASAN_OPTIONS=detect_leaks=0:halt_on_error=1:abort_on_error=1 \
+UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
+    "$host_sanitizer/src/signature/ref/lvl1/test/sqisign_test_keygen_workspace_closure_lvl1"
+
+# The low-memory closure no longer contains the legacy VLA wrapper, so a
+# separate normal-build sanitizer run is required to catch compatibility-path
+# inlining or VLA lifetime regressions.
+host_compat_sanitizer=$scratch/host-normal-asan-ubsan
+configure_normal_host "$host_compat_sanitizer" \
+    -DENABLE_STRICT=OFF \
+    "-DCMAKE_C_FLAGS=-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer -fno-optimize-sibling-calls" \
+    "-DCMAKE_C_FLAGS_RELEASE=-O1 -g -DNDEBUG" \
+    "-DCMAKE_EXE_LINKER_FLAGS=-fsanitize=address,undefined"
+cmake --build "$host_compat_sanitizer" \
+    --target biextension.test_lvl1 \
+             sqisign_test_quaternion_lvl1 \
+             sqisign_test_keygen_workspace_lvl1 \
+             sqisign_test_sign_workspace_lvl1 -j4
+check_special_profile \
+    "$host_compat_sanitizer/compile_commands.json" sanitizer 82
+ASAN_OPTIONS=detect_leaks=0:halt_on_error=1:abort_on_error=1 \
+UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
+    "$host_compat_sanitizer/src/ec/ref/lvl1/test/biextension.test_lvl1" --seed=1
+ASAN_OPTIONS=detect_leaks=0:halt_on_error=1:abort_on_error=1 \
+UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
+    "$host_compat_sanitizer/src/quaternion/ref/generic/test/sqisign_test_quaternion_lvl1" \
+    --seed=1 --ml2-correctness-only
+ASAN_OPTIONS=detect_leaks=0:halt_on_error=1:abort_on_error=1 \
+UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
+    "$host_compat_sanitizer/src/signature/ref/lvl1/test/sqisign_test_keygen_workspace_lvl1" 1
+ASAN_OPTIONS=detect_leaks=0:halt_on_error=1:abort_on_error=1 \
+UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
+    "$host_compat_sanitizer/src/signature/ref/lvl1/test/sqisign_test_sign_workspace_lvl1"
+
+arm_test=$scratch/arm-test-objects
+arm_flags='-mcpu=cortex-m33 -mthumb -march=armv8-m.main+fp+dsp -mcmse -mfloat-abi=softfp -ffreestanding -fstack-usage -Wvla -Walloca -Werror -ffunction-sections -fdata-sections'
+cmake -S "$project_root" -B "$arm_test" -G Ninja \
+    -DCMAKE_SYSTEM_NAME=Generic \
+    -DCMAKE_SYSTEM_PROCESSOR=arm \
+    -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY \
+    -DCMAKE_C_COMPILER="$arm_gcc" \
+    -DCMAKE_ASM_COMPILER="$arm_gcc" \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
+    -DCMAKE_C_FLAGS="$arm_flags" \
+    -DSQISIGN_LOWMEM_ONLY=ON \
+    -DSQISIGN_LOWMEM_DIAGNOSTIC_NO_IPO=ON \
+    -DGF_RADIX=32 \
+    -DENABLE_GMP=OFF \
+    -DENABLE_SIGN=ON \
+    -DENABLE_TESTS=ON
+cmake --build "$arm_test" --target sqisign_lvl1_test -j4
+"$project_root/scripts/audit_lowmem_keygen_closure.sh" "$arm_test" arm-test
+
+echo "$repro_label low-memory encoded KeyGen/Sign/Verify reproduction PASS"
