+        "-mthumb",
+        "-march=armv8-m.main+fp+dsp",
+        "-mcmse",
+        "-mfloat-abi=softfp",
+        "-ffreestanding",
+        "-fstack-usage",
+        "-Wvla",
+        "-Walloca",
+        "-Werror",
