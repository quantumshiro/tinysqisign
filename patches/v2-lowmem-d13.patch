diff --git a/CMakeLists.txt b/CMakeLists.txt
index 811a532ee178e5ea3e43b58f7c2e7e8db004b3ca..ba553b16a6e013c4b8476202adbab3460ffb8aed 100755
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -15,6 +15,12 @@ option(ENABLE_INTBIG_OVERFLOW_CHECK "Abort when fixed-width signed add/sub/mul o
 option(ENABLE_CT_TESTING  "Enable compilation for constant time testing." OFF)
 option(ENABLE_SIGN "Build with sign functionality" ON)
 option(ENABLE_GMP "Enable GMP library (not needed for fixed-precision implementation)" OFF)
+option(SQISIGN_LOWMEM_ONLY
+       "Build the Level-I caller-owned KeyGen/Sign closure without legacy fallbacks"
+       OFF)
+option(SQISIGN_LOWMEM_DIAGNOSTIC_NO_IPO
+       "Disable IPO in the low-memory diagnostic build"
+       OFF)
 
 if(ENABLE_KAT_TESTS AND NOT ENABLE_TESTS)
     message(FATAL_ERROR "ENABLE_KAT_TESTS requires ENABLE_TESTS=ON")
@@ -35,6 +41,31 @@ endif()
 set(GMP_LIBRARY "SYSTEM" CACHE STRING "Which version of GMP to use: SYSTEM, BUILD or MINI")
 set(GF_RADIX "AUTO" CACHE STRING "Set the radix for the gf module (currently supported values: 32 or 64), or AUTO.")
 
+if(SQISIGN_LOWMEM_ONLY)
+    if(NOT ENABLE_SIGN)
+        message(FATAL_ERROR "SQISIGN_LOWMEM_ONLY requires ENABLE_SIGN=ON")
+    endif()
+    if(ENABLE_GMP)
+        message(FATAL_ERROR "SQISIGN_LOWMEM_ONLY requires ENABLE_GMP=OFF")
+    endif()
+    if(NOT GF_RADIX STREQUAL "32")
+        message(FATAL_ERROR "SQISIGN_LOWMEM_ONLY currently requires GF_RADIX=32")
+    endif()
+    if(NOT MSVC)
+        add_compile_options(-Werror=implicit-function-declaration)
+    endif()
+    set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
+    # RP2350 firmware is linked at a fixed address.  Position-independent
+    # Arm objects turn pointer-bearing immutable tables into data.rel.ro,
+    # which the Pico SDK linker may copy into SRAM.  Keep those tables in
+    # read-only flash/XIP in the low-memory profile.
+    set(CMAKE_POSITION_INDEPENDENT_CODE OFF)
+    add_compile_definitions(SQISIGN_LOWMEM_ONLY)
+elseif(SQISIGN_LOWMEM_DIAGNOSTIC_NO_IPO)
+    message(FATAL_ERROR
+            "SQISIGN_LOWMEM_DIAGNOSTIC_NO_IPO requires SQISIGN_LOWMEM_ONLY=ON")
+endif()
+
 if (NOT DEFINED SQISIGN_BUILD_TYPE)
   SET(SQISIGN_BUILD_TYPE "ref")
 endif()
@@ -49,10 +80,17 @@ elseif (${SQISIGN_BUILD_TYPE} MATCHES "arm64crypto")
   add_compile_definitions(SQISIGN_BUILD_TYPE_ARM64CRYPTO SQISIGN_GF_IMPL_REF)
 endif()
 
-SET(SVARIANT_S "lvl1;lvl3;lvl5")
+if(SQISIGN_LOWMEM_ONLY)
+    set(SVARIANT_S "lvl1")
+else()
+    set(SVARIANT_S "lvl1;lvl3;lvl5")
+endif()
 
 include(.cmake/flags.cmake)
 include(.cmake/sanitizers.cmake)
+if(SQISIGN_LOWMEM_DIAGNOSTIC_NO_IPO)
+    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION FALSE)
+endif()
 include(.cmake/target.cmake)
 if(ENABLE_SIGN)
 	add_compile_definitions(ENABLE_SIGN)
@@ -70,8 +108,10 @@ set(SELECT_SQISIGN_VARIANT ${PROJECT_SOURCE_DIR}/.cmake/sqisign_variant.cmake)
 set(INC_PUBLIC ${PROJECT_SOURCE_DIR}/include)
 
 add_subdirectory(src)
-add_subdirectory(apps)
-if(ENABLE_TESTS)
+if(NOT SQISIGN_LOWMEM_ONLY)
+    add_subdirectory(apps)
+endif()
+if(ENABLE_TESTS AND NOT SQISIGN_LOWMEM_ONLY)
     add_subdirectory(test)
 endif()
 
diff --git a/include/mem.h b/include/mem.h
index ab8f6c64814fa9788fc5762cc0de6500712742e8..e9058065362eb23a79f995b196ef23a44354ed12 100755
--- a/include/mem.h
+++ b/include/mem.h
@@ -11,7 +11,9 @@
  * @param[out] mem Memory to be cleared and freed.
  * @param size Size of memory to be cleared and freed.
  */
+#if !defined(SQISIGN_LOWMEM_ONLY)
 void sqisign_secure_free(void *mem, size_t size);
+#endif
 
 /**
  * Clears memory.
@@ -21,4 +23,16 @@ void sqisign_secure_free(void *mem, size_t size);
  */
 void sqisign_secure_clear(void *mem, size_t size);
 
+/* Shared implementations retain the legacy nullable-workspace dispatch in
+ * normal builds.  The low-memory closure compiles only the already-audited
+ * non-NULL arm, so allocator and large automatic fallback edges are absent
+ * from the object code rather than merely unreachable at runtime. */
+#if defined(SQISIGN_LOWMEM_ONLY)
+#define SQISIGN_WORKSPACE_DISPATCH(workspace, workspace_call, legacy_call) \
+    (workspace_call)
+#else
+#define SQISIGN_WORKSPACE_DISPATCH(workspace, workspace_call, legacy_call) \
+    ((workspace) != NULL ? (workspace_call) : (legacy_call))
+#endif
+
 #endif
