+/* Build an order-preserving norm sketch.  For equal bit lengths, unequal
+ * leading words determine the exact integer order.  Equality is deliberately
+ * not treated as equality of norms: the comparator replays both full norms. */
+static int
+finduv_set_norm_sketch(find_uv_norm_sketch_row_t *sketch,
+                       size_t index,
+                       find_uv_norm_eval_workspace_t *eval)
+{
+    int bits;
