--- /dev/null
+++ b/src/signature/ref/lvlx/test/test_keygen_workspace_closure.c
@@ -0,0 +1,913 @@
+#include <stddef.h>
+#include <string.h>
+
+#include <encoded_sizes.h>
+#include <fips202.h>
+#include <rng.h>
+#include <signature_lowmem.h>
+
+enum
+{
+    KEYGEN_WORKSPACE_GUARD_BYTES = 64,
+    THETA_WORKSPACE_GUARD_BYTES = 64,
+    BATCH_WORKSPACE_GUARD_BYTES = 64,
+    DLOG_WORKSPACE_GUARD_BYTES = 64,
+    MP_WORKSPACE_GUARD_BYTES = 64,
+    KEYGEN_POST_RNG_BYTES = 64,
+    KEYGEN_TRANSCRIPT_DIGEST_BYTES = 32,
+    SIGN_MESSAGE_BYTES = 32,
+    SIGN_TRANSCRIPT_DIGEST_BYTES = 32,
+    THETA_NULL_DOMAIN = 1,
+    THETA_NULL_KERNEL = 2,
+    THETA_NULL_CODOMAIN = 4,
+    THETA_NULL_POINTS = 8,
+    THETA_NULL_WORKSPACE = 16
+};
+
+typedef struct guarded_keygen_workspace
+{
+    unsigned char before[KEYGEN_WORKSPACE_GUARD_BYTES];
+    protocols_keygen_workspace_t workspace;
+    unsigned char after[KEYGEN_WORKSPACE_GUARD_BYTES];
+} guarded_keygen_workspace_t;
+
+typedef struct guarded_sign_workspace
+{
+    unsigned char before[KEYGEN_WORKSPACE_GUARD_BYTES];
+    protocols_sign_workspace_t workspace;
+    unsigned char after[KEYGEN_WORKSPACE_GUARD_BYTES];
+} guarded_sign_workspace_t;
+
+typedef struct guarded_verify_workspace
+{
+    unsigned char before[KEYGEN_WORKSPACE_GUARD_BYTES];
+    protocols_verify_workspace_t workspace;
+    unsigned char after[KEYGEN_WORKSPACE_GUARD_BYTES];
+} guarded_verify_workspace_t;
+
+typedef struct guarded_theta_workspace
+{
+    unsigned char before[THETA_WORKSPACE_GUARD_BYTES];
+    theta_chain_workspace_t workspace;
+    unsigned char after[THETA_WORKSPACE_GUARD_BYTES];
+} guarded_theta_workspace_t;
+
+typedef struct guarded_batch_workspace
+{
+    unsigned char before[BATCH_WORKSPACE_GUARD_BYTES];
+    fp2_batched_inv_workspace_t workspace;
+    unsigned char after[BATCH_WORKSPACE_GUARD_BYTES];
+} guarded_batch_workspace_t;
+
+typedef struct guarded_dlog_workspace
+{
+    unsigned char before[DLOG_WORKSPACE_GUARD_BYTES];
+    ec_dlog_2_workspace_t workspace;
+    unsigned char after[DLOG_WORKSPACE_GUARD_BYTES];
+} guarded_dlog_workspace_t;
+
+typedef struct guarded_mp_workspace
+{
+    unsigned char before[MP_WORKSPACE_GUARD_BYTES];
+    mp_invert_matrix_workspace_t workspace;
+    unsigned char after[MP_WORKSPACE_GUARD_BYTES];
+} guarded_mp_workspace_t;
+
+_Static_assert(offsetof(guarded_keygen_workspace_t, workspace) ==
+                   KEYGEN_WORKSPACE_GUARD_BYTES,
+               "padding separates the leading KeyGen guard");
+_Static_assert(offsetof(guarded_keygen_workspace_t, workspace) %
+                       _Alignof(protocols_keygen_workspace_t) ==
+                   0,
+               "KeyGen workspace is misaligned");
+_Static_assert(offsetof(guarded_keygen_workspace_t, after) ==
+                   KEYGEN_WORKSPACE_GUARD_BYTES +
+                       sizeof(protocols_keygen_workspace_t),
+               "padding separates the trailing KeyGen guard");
+_Static_assert(offsetof(guarded_sign_workspace_t, workspace) ==
+                   KEYGEN_WORKSPACE_GUARD_BYTES,
+               "padding separates the leading Sign guard");
+_Static_assert(offsetof(guarded_sign_workspace_t, after) ==
+                   KEYGEN_WORKSPACE_GUARD_BYTES +
+                       sizeof(protocols_sign_workspace_t),
+               "padding separates the trailing Sign guard");
+_Static_assert(offsetof(guarded_verify_workspace_t, workspace) ==
+                   KEYGEN_WORKSPACE_GUARD_BYTES,
+               "padding separates the leading Verify guard");
+_Static_assert(offsetof(guarded_verify_workspace_t, workspace) %
+                       _Alignof(protocols_verify_workspace_t) ==
+                   0,
+               "Verify workspace is misaligned");
+_Static_assert(offsetof(guarded_verify_workspace_t, after) ==
+                   KEYGEN_WORKSPACE_GUARD_BYTES +
+                       sizeof(protocols_verify_workspace_t),
+               "padding separates the trailing Verify guard");
+_Static_assert(offsetof(guarded_theta_workspace_t, workspace) ==
+                   THETA_WORKSPACE_GUARD_BYTES,
+               "padding separates the leading theta guard");
+_Static_assert(offsetof(guarded_theta_workspace_t, workspace) %
+                       _Alignof(theta_chain_workspace_t) ==
+                   0,
+               "theta workspace is misaligned");
+_Static_assert(offsetof(guarded_theta_workspace_t, after) ==
+                   THETA_WORKSPACE_GUARD_BYTES +
+                       sizeof(theta_chain_workspace_t),
+               "padding separates the trailing theta guard");
+_Static_assert(offsetof(guarded_batch_workspace_t, workspace) ==
+                   BATCH_WORKSPACE_GUARD_BYTES,
+               "padding separates the leading batched-inversion guard");
+_Static_assert(offsetof(guarded_batch_workspace_t, workspace) %
+                       _Alignof(fp2_batched_inv_workspace_t) ==
+                   0,
+               "batched-inversion workspace is misaligned");
+_Static_assert(offsetof(guarded_batch_workspace_t, after) ==
+                   BATCH_WORKSPACE_GUARD_BYTES +
+                       sizeof(fp2_batched_inv_workspace_t),
+               "padding separates the trailing batched-inversion guard");
+_Static_assert(offsetof(guarded_dlog_workspace_t, workspace) ==
+                   DLOG_WORKSPACE_GUARD_BYTES,
+               "padding separates the leading dlog guard");
+_Static_assert(offsetof(guarded_dlog_workspace_t, workspace) %
+                       _Alignof(ec_dlog_2_workspace_t) ==
+                   0,
+               "dlog workspace is misaligned");
+_Static_assert(offsetof(guarded_dlog_workspace_t, after) ==
+                   DLOG_WORKSPACE_GUARD_BYTES +
+                       sizeof(ec_dlog_2_workspace_t),
+               "padding separates the trailing dlog guard");
+_Static_assert(offsetof(guarded_mp_workspace_t, workspace) ==
+                   MP_WORKSPACE_GUARD_BYTES,
+               "padding separates the leading MP guard");
+_Static_assert(offsetof(guarded_mp_workspace_t, after) ==
+                   MP_WORKSPACE_GUARD_BYTES +
+                       sizeof(mp_invert_matrix_workspace_t),
+               "padding separates the trailing MP guard");
+
+#if defined(TARGET_ARM) && defined(RADIX_32)
+_Static_assert(sizeof(protocols_keygen_workspace_t) == 172080,
+               "Level-I Cortex-M33 KeyGen arena size changed");
+_Static_assert(sizeof(protocols_sign_workspace_t) == 172080,
+               "Level-I Cortex-M33 Sign arena size changed");
+_Static_assert(sizeof(protocols_verify_workspace_t) == 15428,
+               "Level-I Cortex-M33 Verify scratch size changed");
+_Static_assert(sizeof(protocols_operation_workspace_t) == 172080 &&
+                   _Alignof(protocols_operation_workspace_t) == 8,
+               "Level-I Cortex-M33 operation arena layout changed");
+_Static_assert(offsetof(protocols_operation_workspace_t, keygen) == 0 &&
+                   offsetof(protocols_operation_workspace_t, sign) == 0 &&
+                   offsetof(protocols_operation_workspace_t, verify) == 0,
+               "operation workspaces must share one address");
+_Static_assert(sizeof(ec_eval_even_workspace_t) == 1316 &&
