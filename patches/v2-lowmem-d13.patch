+#!/usr/bin/env python3
+"""Audit an exact D11d-3 low-memory KeyGen build closure.
+
+The audit deliberately works from the objects that were actually produced.  A
+configured-but-unbuilt target is not evidence: every selected compile unit,
+archive member, and (for Arm) stack-usage file is compared with a frozen
+manifest.  Use --emit DIR only while preparing a reviewed manifest update.
+"""
+
+from __future__ import annotations
+
+import argparse
+import difflib
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import re
+import shlex
+import subprocess
+import sys
+
+
+SCRIPT_DIR = Path(__file__).resolve().parent
+
+
+def fail(message: str) -> "NoReturn":
+    raise SystemExit(message)
+
+
+def run(argv: list[str], *, text: bool = True) -> str:
+    result = subprocess.run(
+        argv,
+        check=False,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        text=text,
+    )
+    if result.returncode:
+        stderr = result.stderr if text else result.stderr.decode(errors="replace")
+        fail(f"command failed ({result.returncode}): {' '.join(argv)}\n{stderr}")
+    return result.stdout if text else result.stdout.decode(errors="replace")
+
+
+def read_cache(path: Path) -> dict[str, str]:
+    result: dict[str, str] = {}
+    for line in path.read_text(encoding="utf-8").splitlines():
+        if not line or line.startswith(("#", "//")) or "=" not in line:
+            continue
+        lhs, value = line.split("=", 1)
+        name = lhs.split(":", 1)[0]
+        result[name] = value
+    return result
+
+
+def compare_or_emit(name: str, rows: list[str], manifest: Path, emit: Path | None) -> None:
+    content = "".join(f"{row}\n" for row in rows)
+    if emit is not None:
+        emit.mkdir(parents=True, exist_ok=True)
+        (emit / manifest.name).write_text(content, encoding="utf-8")
+        return
+    if not manifest.is_file():
+        fail(f"missing frozen {name} manifest: {manifest}")
+    expected = manifest.read_text(encoding="utf-8")
+    if expected != content:
+        diff = "".join(
+            difflib.unified_diff(
+                expected.splitlines(keepends=True),
+                content.splitlines(keepends=True),
+                fromfile=str(manifest),
+                tofile=f"observed-{name}",
+            )
+        )
+        fail(f"{name} manifest mismatch\n{diff}")
+
+
+def command_argv(entry: dict[str, object]) -> list[str]:
+    arguments = entry.get("arguments")
+    if isinstance(arguments, list):
+        return [str(value) for value in arguments]
+    command = entry.get("command")
+    if not isinstance(command, str):
+        fail("compile_commands entry has neither arguments nor command")
+    return shlex.split(command)
+
+
+def output_from_argv(argv: list[str], directory: Path) -> Path:
+    try:
+        value = argv[argv.index("-o") + 1]
+    except (ValueError, IndexError):
+        fail(f"compile command has no -o output: {' '.join(argv)}")
+    output = Path(value)
+    return output if output.is_absolute() else directory / output
+
+
+def rel(path: Path, root: Path, description: str) -> str:
+    try:
+        return path.resolve().relative_to(root.resolve()).as_posix()
+    except ValueError:
+        fail(f"{description} is outside its frozen root: {path}")
+
+
+def nm_rows(tool: str, archives: list[Path], *, global_only: bool) -> list[tuple[str, str]]:
+    argv = [tool]
+    if global_only:
+        argv.append("-g")
+    argv.extend(["-P", *map(str, archives)])
+    rows: list[tuple[str, str]] = []
+    for line in run(argv).splitlines():
+        fields = line.split()
+        if len(fields) < 2 or fields[0].endswith(":"):
+            continue
+        symbol, kind = fields[0], fields[1]
+        if len(kind) == 1:
+            rows.append((symbol, kind))
+    return rows
+
+
+def canonical(symbol: str) -> str:
+    # Mach-O adds one platform underscore.  Removing all leading underscores
+    # also normalizes compiler-runtime names for the exact profile allowlist.
+    return symbol.lstrip("_")
+
+
+ALLOCATOR_RE = re.compile(
+    r"^(?:libc_)?(?:malloc|calloc|realloc|reallocarray|free|cfree|sbrk|brk|"
+    r"aligned_alloc|posix_memalign|memalign|valloc|pvalloc|strdup|strndup|"
+    r"asprintf|vasprintf|getline|getdelim)(?:_r)?$"
+)
+STDIO_RE = re.compile(
+    r"^(?:v?f?printf|v?s?n?printf|v?f?scanf|puts|fputs|putchar|getchar|perror|"
+    r"fopen|fdopen|freopen|fclose|fread|fwrite|fflush|fseek|ftell|rewind|"
+    r"setbuf|setvbuf|tmpfile|tmpnam)(?:_chk)?(?:_r)?$"
+)
+GMP_RE = re.compile(r"^(?:gmp|gmp_|mpz_|mpq_|mpn_|mpf_|__gmp)")
+CXX_ALLOC_RE = re.compile(r"^Z(?:n[wa]|d[la])")
+
+LEGACY = {
+    "sqisign_keypair",
+    "sqisign_verify",
+    "sqisign_open",
+    "protocols_keygen",
+    "protocols_sign",
+    "protocols_verify",
+    "protocols_verify_original_release",
+    "find_uv",
+    "fixed_degree_isogeny_and_eval",
+    "dim2id2iso_ideal_to_isogeny_clapotis",
+    "dim2id2iso_arbitrary_isogeny_evaluation",
+    "dim2id2iso_enumerate_hypercube_regression_test",
+    "id2iso_kernel_dlogs_to_ideal_even",
+    "quat_ml2",
+    "quat_ml2_retry",
+    "quat_ml2_retry_with_reducer",
+    "quat_ml2_mlll_with_reducer",
+    "quat_sampling_random_ideal_O0_given_norm",
+    "quat_lideal_create",
+    "quat_lideal_create_with_norm",
+    "quat_lideal_mul",
+    "quat_lideal_add",
+    "quat_lideal_inter",
+    "quat_lideal_right_transporter",
+    "quat_lideal_right_order",
+    "quat_lideal_conjugate_without_hnf",
+    "quat_lideal_lideal_mul_reduced",
+    "quat_lideal_prime_norm_reduced_equivalent",
+    "quat_lattice_add",
+    "quat_lattice_intersect",
+    "quat_lattice_alg_elem_mul",
+    "quat_lattice_mul",
+    "quat_lattice_mul_mlll",
+    "quat_lattice_intersect_mlll",
+    "secret_key_from_bytes",
+    "sqisign_secure_free",
+    "ibz_mat_4xn_hnf_mod_core",
+    "theta_chain_compute_and_eval",
+    "theta_chain_compute_and_eval_randomized",
+    "theta_chain_compute_and_eval_verify",
+    "fp2_batched_inv",
+    "fp2_dlog_2e",
+    "lift_basis",
+    "weil",
+    "reduced_tate",
+    "ec_dlog_2_weil",
+    "ec_dlog_2_tate",
+    "ec_eval_even",
+    "change_of_basis_matrix_tate",
+    "change_of_basis_matrix_tate_invert",
+    "mp_mul",
+    "mp_inv_2e",
+    "mp_invert_matrix",
+}
+
+
+def legacy_name(symbol: str) -> bool:
+    base = canonical(symbol).split(".", 1)[0]
+    return any(base == item or base.endswith("_" + item) for item in LEGACY)
+
+
+def forbidden_reason(symbol: str) -> str | None:
+    name = canonical(symbol).split("@", 1)[0]
+    if ALLOCATOR_RE.match(name) or CXX_ALLOC_RE.match(name):
+        return "allocator"
+    if STDIO_RE.match(name):
+        return "stdio"
+    if GMP_RE.match(name):
+        return "GMP"
+    if legacy_name(name):
+        return "legacy large-stack/fallback"
+    return None
+
+
+def assert_no_forbidden(symbols: set[str], description: str) -> None:
+    rejected = sorted(
+        (symbol, reason)
+        for symbol in symbols
+        if (reason := forbidden_reason(symbol)) is not None
+    )
+    if rejected:
+        details = "\n".join(f"  {reason}: {symbol}" for symbol, reason in rejected)
+        fail(f"forbidden symbols in {description}:\n{details}")
+
+
+REQUIRED = {
+    "sqisign_keypair_with_workspace",
+    "sqisign_sign_with_workspace",
+    "sqisign_verify_with_workspace",
+    "sqisign_open_with_workspace",
+    "protocols_keygen_with_workspace",
+    "protocols_sign_with_workspace",
+    "protocols_verify_with_workspace",
+    "signature_from_bytes",
+    "secret_key_from_bytes_with_workspace",
+    "quat_sampling_random_ideal_O0_given_norm_with_workspace",
+    "quat_lideal_prime_norm_reduced_equivalent_with_workspace",
+    "dim2id2iso_arbitrary_isogeny_evaluation_with_workspace",
+    "dim2id2iso_ideal_to_isogeny_clapotis_with_workspace",
+    "find_uv_with_workspace",
+    "fixed_degree_isogeny_and_eval_with_workspace",
+    "quat_lideal_create_with_norm_with_workspace",
+    "quat_lideal_mul_with_workspace",
+    "quat_lattice_alg_elem_mul_with_workspace",
+    "quat_lattice_mul_with_workspace",
+    "quat_lideal_inter_with_workspace",
+    "quat_lattice_mul_mlll_with_workspace",
+    "quat_lattice_intersect_mlll_with_workspace",
+    "quat_ml2_retry_with_workspace",
+    "quat_ml2_with_workspace",
+    "ibz_mat_4xn_hnf_mod_core_with_workspace",
+    "theta_chain_compute_and_eval_with_workspace",
+    "theta_chain_compute_and_eval_randomized_with_workspace",
+    "theta_chain_compute_and_eval_verify_with_workspace",
+    "fp2_batched_inv_with_workspace",
+    "lift_basis_with_workspace",
+    "weil_with_workspace",
+    "ec_dlog_2_weil_with_workspace",
+    "ec_dlog_2_tate_with_workspace",
+    "change_of_basis_matrix_tate_with_workspace",
+    "change_of_basis_matrix_tate_invert_with_workspace",
+    "mp_mul_with_workspace",
+    "mp_inv_2e_with_workspace",
+    "mp_invert_matrix_with_workspace",
+    "ec_eval_even_with_workspace",
+}
+
+
+def has_required(all_symbols: set[str], required: str) -> bool:
+    return any(
+        canonical(symbol).split(".", 1)[0] == required
+        or canonical(symbol).split(".", 1)[0].endswith("_" + required)
+        for symbol in all_symbols
+    )
+
+
+def scan_objdump(tool: str, artifacts: list[Path], description: str) -> None:
+    output = run([tool, "-dr", *map(str, artifacts)])
+    tokens = set(re.findall(r"[A-Za-z_$][A-Za-z0-9_$.@]*", output))
+    assert_no_forbidden(tokens, f"{description} relocations/disassembly")
+
+
+def normalized_argv_hash(
+    argv: list[str], source_root: Path, build: Path, compiler: str, arm: bool
+) -> str:
+    replacements = [
+        (str(source_root.resolve()), "${SOURCE}"),
+        (str(build.resolve()), "${BUILD}"),
+    ]
+    if arm:
+        replacements.append((str(Path(compiler).resolve().parent), "${ARM_BIN}"))
+    normalized: list[str] = []
+    for token in argv:
+        for original, replacement in replacements:
+            token = token.replace(original, replacement)
+        normalized.append(token)
+    return hashlib.sha256("\0".join(normalized).encode("utf-8")).hexdigest()
+
+
+def disassembly_function_body(output: str, function: str) -> str:
+    match = re.search(
+        rf"<{re.escape(function)}>:(.*?)(?=\n(?:Disassembly of section|[0-9a-f]+ <)|\Z)",
+        output,
+        flags=re.DOTALL,
+    )
+    if match is None:
+        fail(f"Arm object lacks {function} disassembly")
+    return match.group(1)
+
+
+def assert_direct_call(body: str, caller: str, callee: str) -> None:
+    if re.search(rf"R_ARM_(?:THM_)?CALL\s+{re.escape(callee)}(?:\s|$)", body) is None:
+        fail(f"{caller} lacks required direct Arm call to {callee}")
+
+
+def assert_direct_arm_edges(objdump_tool: str, object_path: Path) -> None:
+    output = run([objdump_tool, "-dr", str(object_path)])
+    caller = "quat_lattice_mul_impl"
+    body = disassembly_function_body(output, caller)
+    for callee in (
+        "sqisign_gen_quat_ml2_retry_with_workspace",
+        "sqisign_gen_ibz_mat_4xn_hnf_mod_core_with_workspace",
+    ):
+        assert_direct_call(body, caller, callee)
+
+
+def assert_hnf_workspace_arm_edges(objdump_tool: str, object_path: Path) -> None:
+    output = run([objdump_tool, "-dr", str(object_path)])
+    wrapper = "sqisign_gen_ibz_mat_4xn_hnf_mod_core_with_workspace"
+    implementation = "ibz_mat_4xn_hnf_mod_core_impl"
+    assert_direct_call(
+        disassembly_function_body(output, wrapper), wrapper, implementation
+    )
+    assert_direct_call(
+        disassembly_function_body(output, implementation),
+        implementation,
+        "sqisign_gen_ibz_vec_4_linear_combination_mod",
+    )
+
+
+def assert_theta_workspace_arm_edges(objdump_tool: str, object_path: Path) -> None:
+    output = run([objdump_tool, "-dr", str(object_path)])
+    helper = "theta_chain_compute_with_workspace"
+    assert_direct_call(
+        disassembly_function_body(output, helper),
+        helper,
+        "_theta_chain_compute_core.isra.0",
+    )
+    for wrapper in (
+        "sqisign_lvl1_ref_theta_chain_compute_and_eval_with_workspace",
+        "sqisign_lvl1_ref_theta_chain_compute_and_eval_randomized_with_workspace",
+        "sqisign_lvl1_ref_theta_chain_compute_and_eval_verify_with_workspace",
+    ):
+        assert_direct_call(disassembly_function_body(output, wrapper), wrapper, helper)
+
