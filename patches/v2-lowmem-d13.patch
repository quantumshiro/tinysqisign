+/* Apply permutation[dest] = source to the packed vectors in place.  Completed
+ * cycles are changed to identity entries, so the permutation buffer can be
+ * reused for the next row.  Norm sketches are transient sort metadata and do
+ * not need to follow the now-canonical vector order. */
+static int
+finduv_apply_permutation(find_uv_small_vec_t *vecs,
+                         uint16_t *permutation,
+                         size_t count)
+{
+    if (vecs == NULL || permutation == NULL || count > FINDUV_cube_size) {
+        return 0;
+    }
+    for (size_t start = 0; start < count; start++) {
+        if (permutation[start] == start) {
+            continue;
+        }
+
+        find_uv_small_vec_t vec_scratch = vecs[start];
+        size_t destination = start;
+
+        for (size_t moved = 0; moved < count; moved++) {
+            size_t source = permutation[destination];
+            if (source >= count) {
+                return 0;
+            }
+            permutation[destination] = (uint16_t)destination;
+
+            if (source == start) {
+                vecs[destination] = vec_scratch;
+                destination = start;
+                break;
+            }
+
+            vecs[destination] = vecs[source];
+            destination = source;
+        }
+        if (destination != start) {
+            return 0;
+        }
+    }
+    return 1;
+}
