+static random_ideal_guarded_workspace_t guarded_workspace;
+
+static void
+workspace_fill(void)
+{
+    memset(guarded_workspace.before, 0x69, sizeof(guarded_workspace.before));
+    memset(&guarded_workspace.workspace,
+           0xa5,
+           sizeof(guarded_workspace.workspace));
+    memset(guarded_workspace.after, 0x96, sizeof(guarded_workspace.after));
+}
+
+static int
+workspace_is_intact_and_clear(void)
+{
+    const unsigned char *bytes =
+        (const unsigned char *)&guarded_workspace.workspace;
+    for (size_t i = 0; i < RANDOM_IDEAL_TEST_GUARD_BYTES; i++) {
+        if (guarded_workspace.before[i] != 0x69 ||
+            guarded_workspace.after[i] != 0x96)
+            return 0;
+    }
+    for (size_t i = 0; i < sizeof(guarded_workspace.workspace); i++)
+        if (bytes[i] != 0)
+            return 0;
+    return 1;
+}
+
+static int
+ideal_representation_equal(const quat_left_ideal_t *left,
+                           const quat_left_ideal_t *right)
+{
+    return left->parent_order == right->parent_order &&
+           ibz_cmp(&left->norm, &right->norm) == 0 &&
+           ibz_cmp(&left->lattice.denom, &right->lattice.denom) == 0 &&
+           ibz_mat_4x4_equal(&left->lattice.basis,
+                             &right->lattice.basis);
+}
+
+static int
+run_differential_case(
+    const unsigned char seed[RANDOM_IDEAL_TEST_SEED_BYTES],
+    const ibz_t *ideal_norm,
+    int is_prime,
+    const quat_represent_integer_params_t *params,
+    const ibz_t *prime_cofactor,
+    const quat_alg_t *alg)
+{
+    unsigned char entropy[RANDOM_IDEAL_TEST_SEED_BYTES];
+    unsigned char legacy_post_rng[64], workspace_post_rng[64];
+    quat_left_ideal_t legacy, explicit;
+    quat_random_ideal_status_t legacy_status, explicit_status;
+    ibz_t saved_norm;
+    int failed = 0;
+
+    quat_left_ideal_init(&legacy);
+    quat_left_ideal_init(&explicit);
+    ibz_init(&saved_norm);
+
+    memcpy(entropy, seed, sizeof(entropy));
+    randombytes_init(entropy, NULL, 256);
+    legacy_status = quat_sampling_random_ideal_O0_given_norm(
+        &legacy, ideal_norm, is_prime, params, prime_cofactor);
+    failed |= randombytes(legacy_post_rng, sizeof(legacy_post_rng)) != 0;
+
+    workspace_fill();
+    memcpy(entropy, seed, sizeof(entropy));
+    randombytes_init(entropy, NULL, 256);
+    explicit_status = quat_sampling_random_ideal_O0_given_norm_with_workspace(
+        &explicit,
+        ideal_norm,
+        is_prime,
+        params,
+        prime_cofactor,
+        &guarded_workspace.workspace);
+    failed |= randombytes(workspace_post_rng, sizeof(workspace_post_rng)) != 0;
+
+    failed |= legacy_status != QUAT_RANDOM_IDEAL_SUCCESS;
+    failed |= explicit_status != legacy_status;
+    failed |= !workspace_is_intact_and_clear();
+    failed |= memcmp(legacy_post_rng,
+                     workspace_post_rng,
+                     sizeof(legacy_post_rng)) != 0;
+    if (legacy_status == QUAT_RANDOM_IDEAL_SUCCESS &&
+        explicit_status == QUAT_RANDOM_IDEAL_SUCCESS) {
+        failed |= !ideal_representation_equal(&legacy, &explicit);
+        failed |= !quat_lideal_equals(&legacy, &explicit, alg);
+        ibz_copy(&saved_norm, &explicit.norm);
+        failed |= !quat_lideal_norm(&explicit);
+        failed |= ibz_cmp(&saved_norm, &explicit.norm) != 0;
+    }
+
+    ibz_finalize(&saved_norm);
+    quat_left_ideal_finalize(&explicit);
+    quat_left_ideal_finalize(&legacy);
+    return failed;
+}
+
+static int
+run_null_workspace_case(
+    const unsigned char seed[RANDOM_IDEAL_TEST_SEED_BYTES],
+    const ibz_t *ideal_norm,
+    const quat_represent_integer_params_t *params,
+    const quat_alg_t *alg)
+{
+    unsigned char entropy[RANDOM_IDEAL_TEST_SEED_BYTES];
+    unsigned char expected_post_rng[64], actual_post_rng[64];
+    quat_alg_elem_t generator;
+    quat_left_ideal_t output, before;
+    int failed = 0;
+
+    quat_alg_elem_init(&generator);
+    quat_left_ideal_init(&output);
+    quat_left_ideal_init(&before);
+    quat_alg_elem_set(&generator, 1, 1, 0, 0, 0);
+    if (!quat_lideal_create_principal(
+            &output, &generator, &params->order->order, alg)) {
+        failed = 1;
+        goto cleanup;
+    }
+    quat_lideal_copy(&before, &output);
+
+    memcpy(entropy, seed, sizeof(entropy));
+    randombytes_init(entropy, NULL, 256);
+    failed |= randombytes(expected_post_rng, sizeof(expected_post_rng)) != 0;
+
+    memcpy(entropy, seed, sizeof(entropy));
+    randombytes_init(entropy, NULL, 256);
+    failed |= quat_sampling_random_ideal_O0_given_norm_with_workspace(
+                  &output, ideal_norm, 1, params, NULL, NULL) !=
+              QUAT_RANDOM_IDEAL_FATAL;
+    failed |= randombytes(actual_post_rng, sizeof(actual_post_rng)) != 0;
+    failed |= !ideal_representation_equal(&output, &before);
+    failed |= memcmp(expected_post_rng,
+                     actual_post_rng,
+                     sizeof(expected_post_rng)) != 0;
+
+cleanup:
+    quat_left_ideal_finalize(&before);
+    quat_left_ideal_finalize(&output);
+    quat_alg_elem_finalize(&generator);
+    return failed;
+}
+
+int
+main(void)
+{
+    static const unsigned char seed[RANDOM_IDEAL_TEST_SEED_BYTES] = {
+        0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
+        0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
+        0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
+        0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,
+        0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27,
+        0x28, 0x29, 0x2a, 0x2b, 0x2c, 0x2d, 0x2e, 0x2f,
+    };
+    quat_alg_t alg;
+    quat_p_extremal_maximal_order_t O0;
+    quat_represent_integer_params_t params;
+    ibz_t algebra_prime, ideal_norm, prime_cofactor;
+    int failed = 0;
+
+    quat_alg_elem_init(&O0.z);
+    quat_alg_elem_init(&O0.t);
+    quat_lattice_init(&O0.order);
+    ibz_init(&algebra_prime);
+    ibz_init(&ideal_norm);
+    ibz_init(&prime_cofactor);
+
+    ibz_set(&algebra_prime, 1533069323);
+    quat_alg_init_set(&alg, &algebra_prime);
+    quat_lattice_O0_set_extremal(&O0);
+    params.primality_test_iterations = 30;
+    params.order = &O0;
+    params.algebra = &alg;
+
+    /* Prime sampling is used by KeyGen and commitment generation. */
+    ibz_set(&ideal_norm, 1338708463);
+    failed |= run_differential_case(
+        seed, &ideal_norm, 1, &params, NULL, &alg);
+    failed |= run_null_workspace_case(
+        seed, &ideal_norm, &params, &alg);
+
+    /* Auxiliary signing samples a composite norm with a prime cofactor. */
+    ibz_set(&ideal_norm, 3093 * 59471);
+    ibz_set(&prime_cofactor, 1533069337);
+    failed |= run_differential_case(
+        seed, &ideal_norm, 0, &params, &prime_cofactor, &alg);
+
+    if (failed)
+        fprintf(stderr,
+                "random-ideal legacy/workspace deterministic differential failed\n");
+
+    ibz_finalize(&prime_cofactor);
+    ibz_finalize(&ideal_norm);
+    quat_alg_finalize(&alg);
+    ibz_finalize(&algebra_prime);
+    quat_lattice_finalize(&O0.order);
+    quat_alg_elem_finalize(&O0.t);
+    quat_alg_elem_finalize(&O0.z);
+    return failed;
+}
