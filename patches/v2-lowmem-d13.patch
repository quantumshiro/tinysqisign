+def main() -> None:
+    args = parse_args()
+    build = args.build_dir.resolve()
+    cache_path = build / "CMakeCache.txt"
+    commands_path = build / "compile_commands.json"
+    if not cache_path.is_file() or not commands_path.is_file():
+        fail("build lacks CMakeCache.txt or compile_commands.json")
+    cache = read_cache(cache_path)
+    source_root = Path(cache.get("CMAKE_HOME_DIRECTORY", "")).resolve()
+    if not source_root.is_dir():
+        fail("CMAKE_HOME_DIRECTORY is missing or invalid")
+
+    expected_tests = "OFF" if args.profile == "production" else "ON"
+    expected_no_ipo = "OFF" if args.profile == "test-lto" else "ON"
+    expected_cache = {
+        "CMAKE_BUILD_TYPE": "Release",
+        "SQISIGN_LOWMEM_ONLY": "ON",
+        "SQISIGN_LOWMEM_DIAGNOSTIC_NO_IPO": expected_no_ipo,
+        "GF_RADIX": "32",
+        "ENABLE_GMP": "OFF",
+        "ENABLE_SIGN": "ON",
+        "ENABLE_TESTS": expected_tests,
+    }
+    for key, value in expected_cache.items():
+        if cache.get(key) != value:
+            fail(f"{key}: expected {value}, observed {cache.get(key)!r}")
+
+    commands = json.loads(commands_path.read_text(encoding="utf-8"))
+    selected: list[tuple[str, str, Path, list[str]]] = []
+    for entry in commands:
+        argv = command_argv(entry)
+        directory = Path(str(entry.get("directory", build)))
+        output = output_from_argv(argv, directory).resolve()
+        if not output.is_file():
+            continue
+        source = Path(str(entry["file"])).resolve()
+        selected.append(
+            (
+                rel(source, source_root, "source"),
+                rel(output, build, "object"),
+                output,
+                argv,
+            )
+        )
+    selected.sort(key=lambda row: (row[0], row[1]))
+    if not selected:
+        fail("no actually built compile units were selected")
+
+    manifest_key = "arm_test" if args.profile == "arm-test" else "test" if args.profile == "test-lto" else args.profile
+    source_rows = sorted({row[0] for row in selected})
+    compare_or_emit(
+        "source",
+        source_rows,
+        SCRIPT_DIR / f"lowmem_keygen_sources_{manifest_key}.txt",
+        args.emit,
+    )
+    compiler = cache.get("CMAKE_C_COMPILER", "")
+    compile_key = args.profile.replace("-", "_")
+    compile_rows = [
+        f"{source}\t{output}\t"
+        f"{normalized_argv_hash(argv, source_root, build, compiler, args.profile == 'arm-test')}"
+        for source, output, _, argv in selected
