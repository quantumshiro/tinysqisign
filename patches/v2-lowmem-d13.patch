diff --git a/src/verification/ref/include/verification_lowmem.h b/src/verification/ref/include/verification_lowmem.h
new file mode 100644
index 0000000000000000000000000000000000000000..88292e410222a48bc965446e8ca022e0dc3ce774
--- /dev/null
+++ b/src/verification/ref/include/verification_lowmem.h
@@ -0,0 +1,45 @@
+/** @file
+ *
+ * Explicit bounded-storage interface for signature verification.
+ */
+
+#ifndef VERIFICATION_LOWMEM_H
+#define VERIFICATION_LOWMEM_H
+
+#include <verification.h>
+#include <hd.h>
+
+/**
+ * Caller-owned bounded storage for low-memory signature verification.
+ *
+ * The challenge isogeny and the product theta chain are sequential, so both
+ * bounded scratch objects share offset zero.  The object may contain values
+ * derived from an untrusted signature and must be disjoint from every input
+ * and output until the call returns.
+ */
+typedef union protocols_verify_workspace
+{
+    ec_eval_even_workspace_t even_isogeny;
+    theta_chain_workspace_t theta;
+} protocols_verify_workspace_t;
+
+/** Clear a new or reusable caller-owned Verify workspace. */
+void protocols_verify_workspace_init(protocols_verify_workspace_t *workspace);
+
+/** Securely clear every byte of a caller-owned Verify workspace. */
+void protocols_verify_workspace_clear(protocols_verify_workspace_t *workspace);
+
+/**
+ * Verify using explicit bounded caller-owned storage.
+ *
+ * Every byte of a non-NULL workspace is securely cleared on every return
+ * path.  The function returns one for a valid signature and zero for an
+ * invalid signature, matching protocols_verify.
+ */
+int protocols_verify_with_workspace(signature_t *sig,
+                                    const public_key_t *pk,
+                                    const unsigned char *m,
+                                    size_t l,
+                                    protocols_verify_workspace_t *workspace);
+
+#endif
