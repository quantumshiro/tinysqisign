+ * Most comparisons finish on the certified sketch.  A sketch tie always
+ * replays both norms, so this is deterministic and collision-free rather than
+ * a probabilistic hash optimization. */
+static int
+finduv_compare_indices(finduv_sort_context_t *context,
+                       uint16_t first,
+                       uint16_t second)
+{
+    int result;
