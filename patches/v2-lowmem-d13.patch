+static int
+dlog_reject_contract_passes(void)
+{
+    digit_t r1[NWORDS_ORDER], r2[NWORDS_ORDER];
+    digit_t s1[NWORDS_ORDER], s2[NWORDS_ORDER];
+    digit_t r1_before[NWORDS_ORDER], r2_before[NWORDS_ORDER];
+    digit_t s1_before[NWORDS_ORDER], s2_before[NWORDS_ORDER];
+    ec_basis_t PQ, RS, PQ_before, RS_before;
+    ec_curve_t curve, curve_before;
+    int ok = 1;
+
+    memset(r1, 0x11, sizeof(r1));
+    memset(r2, 0x22, sizeof(r2));
+    memset(s1, 0x33, sizeof(s1));
+    memset(s2, 0x44, sizeof(s2));
+    memcpy(r1_before, r1, sizeof(r1));
+    memcpy(r2_before, r2, sizeof(r2));
+    memcpy(s1_before, s1, sizeof(s1));
+    memcpy(s2_before, s2, sizeof(s2));
+    memset(&PQ, 0x55, sizeof(PQ));
+    memset(&RS, 0x66, sizeof(RS));
+    memset(&curve, 0x77, sizeof(curve));
+    memcpy(&PQ_before, &PQ, sizeof(PQ));
+    memcpy(&RS_before, &RS, sizeof(RS));
+    memcpy(&curve_before, &curve, sizeof(curve));
+
+    dlog_workspace_fill();
+    ok &= ec_dlog_2_tate_with_workspace(r1,
+                                        r2,
+                                        s1,
+                                        s2,
+                                        &PQ,
+                                        &RS,
+                                        &curve,
+                                        0,
+                                        &guarded_dlog.workspace) == 0;
+    ok &= dlog_workspace_is_guarded(0x00);
+
+    dlog_workspace_fill();
+    ok &= ec_dlog_2_weil_with_workspace(r1,
+                                        r2,
+                                        s1,
+                                        s2,
+                                        &PQ,
+                                        &RS,
+                                        &curve,
+                                        TORSION_EVEN_POWER + 1,
+                                        &guarded_dlog.workspace) == 0;
+    ok &= dlog_workspace_is_guarded(0x00);
+
+    dlog_workspace_fill();
+    ok &= ec_dlog_2_tate_with_workspace(
+              r1, r2, s1, s2, &PQ, &RS, &curve, 1, NULL) == 0;
+    ok &= dlog_workspace_is_guarded(0xa5);
+
+    ok &= bytes_are_equal(r1, r1_before, sizeof(r1));
+    ok &= bytes_are_equal(r2, r2_before, sizeof(r2));
+    ok &= bytes_are_equal(s1, s1_before, sizeof(s1));
+    ok &= bytes_are_equal(s2, s2_before, sizeof(s2));
+    ok &= bytes_are_equal(&PQ, &PQ_before, sizeof(PQ));
+    ok &= bytes_are_equal(&RS, &RS_before, sizeof(RS));
+    ok &= bytes_are_equal(&curve, &curve_before, sizeof(curve));
+    return ok;
+}
