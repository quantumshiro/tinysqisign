+    if (context == NULL || context->sketch == NULL || context->vecs == NULL ||
+        context->gram == NULL || context->adjusted_norm == NULL ||
+        context->eval == NULL || first >= FINDUV_cube_size ||
+        second >= FINDUV_cube_size) {
+        if (context != NULL) {
+            context->fatal = 1;
+        }
+        return (first > second) - (first < second);
+    }
+#if defined(SQISIGN_FINDUV_SKETCH_PROFILE)
+    context->comparisons++;
+#endif
+    if (first == second) {
+        return 0;
+    }
+    if (context->sketch->bit_length[first] !=
+        context->sketch->bit_length[second]) {
+        return (context->sketch->bit_length[first] >
+                context->sketch->bit_length[second]) -
+               (context->sketch->bit_length[first] <
+                context->sketch->bit_length[second]);
+    }
+    if (context->sketch->leading[first] !=
+        context->sketch->leading[second]) {
+        return (context->sketch->leading[first] >
+                context->sketch->leading[second]) -
+               (context->sketch->leading[first] <
+                context->sketch->leading[second]);
+    }
