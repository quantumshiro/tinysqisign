diff --git a/src/sqisign_lowmem.c b/src/sqisign_lowmem.c
new file mode 100644
index 0000000000000000000000000000000000000000..8eeacfacfaa61e08820e11e9d3a18351ba7fc84d
--- /dev/null
+++ b/src/sqisign_lowmem.c
@@ -0,0 +1,163 @@
+#include <encoded_sizes.h>
+#include <signature_lowmem.h>
+#include <stddef.h>
+#include <string.h>
+
+#if defined(TARGET_ARM) && defined(RADIX_32)
+_Static_assert(sizeof(protocols_operation_workspace_t) == 172080 &&
+                   _Alignof(protocols_operation_workspace_t) == 8,
+               "Level-I Cortex-M33 operation arena layout changed");
+_Static_assert(offsetof(protocols_operation_workspace_t, keygen) == 0 &&
+                   offsetof(protocols_operation_workspace_t, sign) == 0 &&
+                   offsetof(protocols_operation_workspace_t, verify) == 0,
+               "operation workspaces must share one address");
+#endif
+
+#if defined(ENABLE_SIGN)
+SQISIGN_API
+int
+sqisign_keypair_with_workspace(unsigned char *pk,
+                               unsigned char *sk,
+                               protocols_keygen_workspace_t *workspace)
+{
+    if (workspace == NULL) {
+        return 1;
+    }
+
+    secret_key_t secret_key;
+    public_key_t public_key = { 0 };
+    secret_key_init(&secret_key);
+
+    if (!protocols_keygen_with_workspace(
+            &public_key, &secret_key, workspace)) {
+        goto fail;
+    }
+
+    if (!secret_key_to_bytes(sk, &secret_key, &public_key)) {
+        goto fail;
+    }
+    public_key_to_bytes(pk, &public_key);
+    secret_key_finalize(&secret_key);
+    return 0;
+
+fail:
+    memset(pk, 0, PUBLICKEY_BYTES);
+    memset(sk, 0, SECRETKEY_BYTES);
+    secret_key_finalize(&secret_key);
+    return 1;
+}
+
+SQISIGN_API
+int
+sqisign_sign_with_workspace(unsigned char *sm,
+                            unsigned long long *smlen,
+                            const unsigned char *m,
+                            unsigned long long mlen,
+                            const unsigned char *sk,
+                            protocols_sign_workspace_t *workspace)
+{
+    if (workspace == NULL) {
+        return 1;
+    }
+
+    int result = 1;
+    secret_key_t secret_key;
+    public_key_t public_key = { 0 };
+    signature_t signature;
+    secret_key_init(&secret_key);
+    protocols_sign_workspace_init(workspace);
+
+    if (!secret_key_from_bytes_with_workspace(
+            &secret_key, &public_key, sk, &workspace->ml2)) {
+        *smlen = 0;
+        goto cleanup;
+    }
+
+    memmove(sm + SIGNATURE_BYTES, m, mlen);
+    if (!protocols_sign_with_workspace(&signature,
+                                       &public_key,
+                                       &secret_key,
+                                       sm + SIGNATURE_BYTES,
+                                       mlen,
+                                       workspace)) {
+        *smlen = 0;
+        goto cleanup;
+    }
+
+    signature_to_bytes(sm, &signature);
+    *smlen = SIGNATURE_BYTES + mlen;
+    result = 0;
+
+cleanup:
+    protocols_sign_workspace_clear(workspace);
+    secret_key_finalize(&secret_key);
+    return result;
+}
+
+SQISIGN_API
+int
+sqisign_verify_with_workspace(const unsigned char *m,
+                              unsigned long long mlen,
+                              const unsigned char *sig,
+                              unsigned long long siglen,
+                              const unsigned char *pk,
+                              protocols_verify_workspace_t *workspace)
+{
+    if (workspace == NULL)
+        return 1;
+    protocols_verify_workspace_init(workspace);
+    if (siglen != SIGNATURE_BYTES) {
+        protocols_verify_workspace_clear(workspace);
+        return 1;
+    }
+
+    public_key_t public_key = { 0 };
+    signature_t signature;
+    if (public_key_from_bytes(&public_key, pk) == NULL ||
+        !signature_from_bytes(&signature, sig)) {
+        protocols_verify_workspace_clear(workspace);
+        return 1;
+    }
+
+    return !protocols_verify_with_workspace(
+        &signature, &public_key, m, mlen, workspace);
+}
+
+SQISIGN_API
+int
+sqisign_open_with_workspace(unsigned char *m,
+                            unsigned long long *mlen,
+                            const unsigned char *sm,
+                            unsigned long long smlen,
+                            const unsigned char *pk,
+                            protocols_verify_workspace_t *workspace)
+{
+    if (workspace == NULL)
+        return 1;
+    if (smlen < SIGNATURE_BYTES) {
+        *mlen = 0;
+        memset(m, 0, smlen);
+        protocols_verify_workspace_clear(workspace);
+        return 1;
+    }
+
+    public_key_t public_key = { 0 };
+    signature_t signature;
+    if (public_key_from_bytes(&public_key, pk) == NULL ||
+        !signature_from_bytes(&signature, sm) ||
+        !protocols_verify_with_workspace(&signature,
+                                         &public_key,
+                                         sm + SIGNATURE_BYTES,
+                                         smlen - SIGNATURE_BYTES,
+                                         workspace)) {
+        *mlen = 0;
+        memset(m, 0, smlen - SIGNATURE_BYTES);
+        protocols_verify_workspace_clear(workspace);
+        return 1;
+    }
+
+    *mlen = smlen - SIGNATURE_BYTES;
+    memmove(m, sm + SIGNATURE_BYTES, *mlen);
+    return 0;
+}
+#endif
